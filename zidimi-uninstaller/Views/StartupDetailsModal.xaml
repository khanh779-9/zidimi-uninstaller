<UserControl x:Class="zidimi_uninstaller.Views.StartupDetailsModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:zidimi_uninstaller.Controls"
             xmlns:services="clr-namespace:zidimi_uninstaller.Services"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="750">
    <Border Background="{StaticResource ZBrushWhite}" CornerRadius="16"
            BorderBrush="{StaticResource ZBrushLightGray}" BorderThickness="1"
            Padding="26" Width="720" MaxWidth="760"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="10" Opacity="0.28" Color="#000000"/>
        </Border.Effect>

        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="52" Height="52" CornerRadius="13" Background="{StaticResource ZBrushCard}" VerticalAlignment="Center">
                    <Image Source="{Binding SelectedEntry.Icon}" Width="36" Height="36" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedEntry.Name}" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource ZBrushBlack}" TextTrimming="CharacterEllipsis"/>
                    <WrapPanel Margin="0,6,0,0">
                        <controls:ZBadge Content="{Binding SelectedEntry.ScopeText}" Variant="Info"/>
                        <controls:ZBadge Content="{Binding SelectedEntry.LocationShort}" Variant="Neutral" Margin="6,0,0,0"/>
                        <controls:ZBadge Content="{Binding SelectedEntry.StatusText}"
                                         Variant="{Binding SelectedEntry.StatusBadgeVariant}"
                                         Margin="6,0,0,0"/>
                    </WrapPanel>
                </StackPanel>

                <controls:ZIconButton Grid.Column="2" Icon="{StaticResource IconClose}"
                                      Command="{Binding CloseDetailsCommand}"
                                      ToolTip="{Binding [Apps_CloseTooltip], Source={x:Static services:LanguageManager.Instance}}"/>
            </Grid>

            <Separator Height="1" Background="{StaticResource ZBrushLightGray}" Margin="0,0,0,16"/>

            <!-- Details Grid -->
            <Grid Margin="4,0,4,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <controls:ZInfoRow Label="{Binding [Startup_ItemName], Source={x:Static services:LanguageManager.Instance}}" Value="{Binding SelectedEntry.Name}"/>
                    <controls:ZInfoRow Label="{Binding [Startup_PublisherLabel], Source={x:Static services:LanguageManager.Instance}}" Value="{Binding SelectedEntry.Publisher}"/>
                    <controls:ZInfoRow Label="{Binding [Startup_StatusLabel], Source={x:Static services:LanguageManager.Instance}}" Value="{Binding SelectedEntry.StatusText}"/>
                    <controls:ZInfoRow Label="{Binding [Startup_ScopeLabel], Source={x:Static services:LanguageManager.Instance}}" Value="{Binding SelectedEntry.ScopeText}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <controls:ZInfoRow Label="{Binding [Startup_ExecutableLabel], Source={x:Static services:LanguageManager.Instance}}" Value="{Binding SelectedEntry.ExecutablePath}"/>
                    <controls:ZInfoRow Label="{Binding [Startup_CommandLabel], Source={x:Static services:LanguageManager.Instance}}" Value="{Binding SelectedEntry.Command}"/>
                    <controls:ZInfoRow Label="{Binding [Startup_LocationLabel], Source={x:Static services:LanguageManager.Instance}}" Value="{Binding SelectedEntry.Location}"/>
                </StackPanel>
            </Grid>

            <Separator Height="1" Background="{StaticResource ZBrushLightGray}" Margin="0,0,0,16"/>

            <!-- Actions -->
            <WrapPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <controls:ZButton Content="{Binding [Apps_OpenFolder], Source={x:Static services:LanguageManager.Instance}}"
                                  Variant="Secondary" Icon="{StaticResource IconFolder}"
                                  Command="{Binding OpenLocationCommand}" Margin="0,0,8,8"/>
                <controls:ZButton Content="{Binding [Startup_OpenRegedit], Source={x:Static services:LanguageManager.Instance}}"
                                  Variant="Secondary" Icon="{StaticResource IconExternal}"
                                  Command="{Binding OpenRegistryCommand}"
                                  Margin="0,0,8,8"/>
                <controls:ZButton Content="{Binding [Startup_ToggleBtn], Source={x:Static services:LanguageManager.Instance}}"
                                  Variant="Primary"
                                  Command="{Binding ToggleSelectedCommand}" Margin="0,0,8,8"/>
                <controls:ZButton Content="{Binding [Apps_Close], Source={x:Static services:LanguageManager.Instance}}" Variant="Secondary"
                                  Command="{Binding CloseDetailsCommand}" Margin="0,0,0,8"/>
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
