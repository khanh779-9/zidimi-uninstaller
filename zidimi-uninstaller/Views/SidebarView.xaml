<UserControl x:Class="zidimi_uninstaller.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:zidimi_uninstaller.Controls"
             xmlns:services="clr-namespace:zidimi_uninstaller.Services"
             mc:Ignorable="d"
             d:DesignWidth="216" d:DesignHeight="680"
             Width="216">
    <Border Background="{StaticResource ZBrushDark}"
            BorderBrush="{StaticResource ZBrushSidebarBorder}"
            BorderThickness="0,0,1,0">
        <Grid Margin="8,10,8,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="True">
                <ItemsControl ItemsSource="{Binding NavItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:ZNavButton Content="{Binding Title}"
                                                 Icon="{Binding Icon}"
                                                 IsActive="{Binding IsActive}"
                                                 AutomationProperties.Name="{Binding Title}"
                                                 Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                 CommandParameter="{Binding Key}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="6,10,6,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Height="1"
                        Margin="0,0,0,9"
                        Background="{StaticResource ZBrushSidebarBorder}"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Padding="6,3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="#14FFFFFF"
                            CornerRadius="6">
                        <TextBlock Text="{Binding AppVersion, StringFormat=Version {0}}"
                                   FontSize="10.5"
                                   Foreground="{StaticResource ZBrushSidebarText}"/>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <controls:ZIconButton Icon="{StaticResource StrokeIconReloadAll}"
                                              Variant="Sidebar"
                                              GlyphSize="14"
                                              Foreground="{StaticResource ZBrushSidebarText}"
                                              Command="{Binding ReloadAllCommand}"
                                              ToolTip="{Binding [Sidebar_ReloadAll], Source={x:Static services:LanguageManager.Instance}}"
                                              AutomationProperties.Name="{Binding [Sidebar_ReloadAll], Source={x:Static services:LanguageManager.Instance}}"/>
                        <controls:ZIconButton Icon="{StaticResource StrokeIconInfo}"
                                              Variant="Sidebar"
                                              GlyphSize="14"
                                              Foreground="{StaticResource ZBrushSidebarText}"
                                              Margin="3,0,0,0"
                                              Command="{Binding OpenAboutCommand}"
                                              ToolTip="{Binding [Sidebar_About], Source={x:Static services:LanguageManager.Instance}}"
                                              AutomationProperties.Name="{Binding [Sidebar_About], Source={x:Static services:LanguageManager.Instance}}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
