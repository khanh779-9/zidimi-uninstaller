<UserControl x:Class="zidimi_uninstaller.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:zidimi_uninstaller.Controls"
             xmlns:services="clr-namespace:zidimi_uninstaller.Services"
             mc:Ignorable="d"
             d:DesignWidth="248" d:DesignHeight="720"
             Width="248">
    <Border Background="{StaticResource ZBrushDark}"
            BorderBrush="{StaticResource ZBrushSidebarBorder}"
            BorderThickness="0,0,1,0">
        <Grid Margin="16,20,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="8,0,8,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="38" Height="38"
                        Background="#22EA0232"
                        BorderBrush="#55EA0232"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Path Data="{StaticResource StrokeIconApps}"
                          Width="18" Height="18"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Fill="Transparent"
                          Stroke="{StaticResource ZBrushAccent}"
                          StrokeThickness="1.7"
                          StrokeLineJoin="Round"
                          Stretch="Uniform"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Zidimi"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                    <TextBlock Text="Uninstaller"
                               Margin="0,1,0,0"
                               FontSize="11"
                               Foreground="{StaticResource ZBrushSidebarText}"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="True">
                <ItemsControl ItemsSource="{Binding NavItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:ZNavButton Content="{Binding Title}"
                                                 Icon="{Binding Icon}"
                                                 IsActive="{Binding IsActive}"
                                                 AutomationProperties.Name="{Binding Title}"
                                                 Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                 CommandParameter="{Binding Key}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="8,14,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Height="1"
                        Margin="0,0,0,12"
                        Background="{StaticResource ZBrushSidebarBorder}"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Padding="8,4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="#14FFFFFF"
                            CornerRadius="6">
                        <TextBlock Text="{Binding AppVersion, StringFormat=Version {0}}"
                                   FontSize="11"
                                   Foreground="{StaticResource ZBrushSidebarText}"/>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <controls:ZIconButton Icon="{StaticResource StrokeIconReloadAll}"
                                              Variant="Sidebar"
                                              GlyphSize="16"
                                              Foreground="{StaticResource ZBrushSidebarText}"
                                              Command="{Binding ReloadAllCommand}"
                                              ToolTip="{Binding [Sidebar_ReloadAll], Source={x:Static services:LanguageManager.Instance}}"
                                              AutomationProperties.Name="{Binding [Sidebar_ReloadAll], Source={x:Static services:LanguageManager.Instance}}"/>
                        <controls:ZIconButton Icon="{StaticResource StrokeIconInfo}"
                                              Variant="Sidebar"
                                              GlyphSize="16"
                                              Foreground="{StaticResource ZBrushSidebarText}"
                                              Margin="4,0,0,0"
                                              Command="{Binding OpenAboutCommand}"
                                              ToolTip="{Binding [Sidebar_About], Source={x:Static services:LanguageManager.Instance}}"
                                              AutomationProperties.Name="{Binding [Sidebar_About], Source={x:Static services:LanguageManager.Instance}}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
