<UserControl x:Class="zidimi_uninstaller.Views.PackagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:zidimi_uninstaller.Controls"
             xmlns:services="clr-namespace:zidimi_uninstaller.Services"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <controls:ZSearchBox Placeholder="{Binding [Packages_SearchPlaceholder], Source={x:Static services:LanguageManager.Instance}}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 MaxWidth="460" HorizontalAlignment="Left"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <controls:ZIconButton Icon="{StaticResource IconRefresh}"
                                      Command="{Binding RefreshCommand}"
                                      ToolTip="{Binding [Packages_RescanTooltip], Source={x:Static services:LanguageManager.Instance}}"/>
            </StackPanel>
        </Grid>

        <!-- Packages List -->
        <Grid Grid.Row="1">
            <ListBox ItemsSource="{Binding ItemsView}"
                     SelectedItem="{Binding SelectedPackage}"
                     ItemContainerStyle="{StaticResource ZAppsListItemStyle}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <controls:ZAppCard Title="{Binding Name}"
                                           Subtitle="{Binding Id}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <controls:ZBadge Content="{Binding Version, StringFormat='v{0}'}" Variant="Neutral" Margin="0,0,8,0"/>
                                <controls:ZBadge Content="{Binding AvailableVersion, StringFormat='v{0}'}"
                                                 Variant="Accent" Margin="0,0,8,0"
                                                 Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}"/>
                                <controls:ZBadge Content="{Binding ManagerText}"
                                                 Variant="{Binding ManagerBadgeVariant}" Margin="0,0,8,0"/>

                                <controls:ZButton Content="{Binding [Packages_Upgrade], Source={x:Static services:LanguageManager.Instance}}" Variant="Primary" Margin="0,0,8,0"
                                                  Command="{Binding DataContext.UpgradeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"
                                                  Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}"/>

                                <controls:ZButton Content="{Binding [Packages_Uninstall], Source={x:Static services:LanguageManager.Instance}}" Variant="Ghost"
                                                  Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>
                            </StackPanel>
                        </controls:ZAppCard>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty state -->
            <controls:ZEmptyState Icon="{StaticResource IconApps}"
                                  Title="{Binding [Packages_EmptyTitle], Source={x:Static services:LanguageManager.Instance}}"
                                  Subtitle="{Binding [Packages_EmptySubtitle], Source={x:Static services:LanguageManager.Instance}}"
                                  Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}"/>

            <controls:ZEmptyState Icon="{StaticResource IconSearch}"
                                  Title="{Binding [Packages_NoResultsTitle], Source={x:Static services:LanguageManager.Instance}}"
                                  Subtitle="{Binding [Packages_NoResultsSubtitle], Source={x:Static services:LanguageManager.Instance}}"
                                  Visibility="{Binding ShowNoResults, Converter={StaticResource BoolToVis}}"/>

            <!-- Loading overlay -->
            <Border Background="#99FFFFFF" CornerRadius="12"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <controls:ZProgressRing RingSize="42"/>
                    <TextBlock Text="{Binding [Packages_Scanning], Source={x:Static services:LanguageManager.Instance}}"
                               Foreground="{StaticResource ZBrushGray}" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status bar -->
        <TextBlock Grid.Row="2" Margin="6,10,6,0" FontSize="12" Foreground="{StaticResource ZBrushGray}">
            <Run Text="{Binding StatusText, Mode=OneWay}"/>
        </TextBlock>
    </Grid>
</UserControl>
