<UserControl x:Class="zidimi_uninstaller.Views.AboutModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:zidimi_uninstaller.Controls"
             xmlns:services="clr-namespace:zidimi_uninstaller.Services"
             mc:Ignorable="d"
             d:DesignHeight="520" d:DesignWidth="680">
    <Border Background="{StaticResource ZBrushWhite}" CornerRadius="18"
            BorderBrush="{StaticResource ZBrushLightGray}" BorderThickness="1"
            Padding="30" Width="640" MaxWidth="680"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="12" Opacity="0.25" Color="#000000"/>
        </Border.Effect>

        <StackPanel>
            <!-- Header with Logo and App Name -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App Icon Container -->
                <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource ZBrushCard}"
                        BorderBrush="{StaticResource ZBrushLightGray}" BorderThickness="1"
                        VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/zidimi-icon.ico" Width="44" Height="44"
                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <!-- Title & Version Badges -->
                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Zidimi Uninstaller" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource ZBrushBlack}"/>
                    <WrapPanel Margin="0,6,0,0">
                        <controls:ZBadge Content="{Binding AppVersion, StringFormat=v{0}}" Variant="Accent"/>
                        <controls:ZBadge Content="Windows 64-bit" Variant="Neutral" Margin="6,0,0,0"/>
                        <controls:ZBadge Content=".NET 8.0 WPF" Variant="Info" Margin="6,0,0,0"/>
                    </WrapPanel>
                </StackPanel>

                <!-- Close Icon Button -->
                <controls:ZIconButton Grid.Column="2" Icon="{StaticResource IconClose}"
                                      Command="{Binding CloseAboutCommand}"
                                      ToolTip="{Binding [Apps_CloseTooltip], Source={x:Static services:LanguageManager.Instance}}"/>
            </Grid>

            <!-- Description -->
            <TextBlock Text="{Binding [About_Tagline], Source={x:Static services:LanguageManager.Instance}}"
                       FontSize="13.5" LineHeight="20" Foreground="{StaticResource ZBrushGray}"
                       TextWrapping="Wrap" Margin="2,0,2,18"/>

            <Separator Height="1" Background="{StaticResource ZBrushLightGray}" Margin="0,0,0,18"/>

            <!-- Information Matrix Cards -->
            <UniformGrid Columns="2" Margin="0,0,0,20">
                <StackPanel Margin="0,0,14,0">
                    <controls:ZInfoRow Label="{Binding [About_AuthorLabel], Source={x:Static services:LanguageManager.Instance}}" Value="khanh779-9"/>
                    <controls:ZInfoRow Label="{Binding [About_LicenseLabel], Source={x:Static services:LanguageManager.Instance}}" Value="MIT (Trademark Protected)"/>
                    <controls:ZInfoRow Label="{Binding [About_PlatformLabel], Source={x:Static services:LanguageManager.Instance}}" Value="Windows 10 / 11"/>
                </StackPanel>
                <StackPanel Margin="14,0,0,0">
                    <controls:ZInfoRow Label="{Binding [About_FrameworkLabel], Source={x:Static services:LanguageManager.Instance}}" Value=".NET 8.0 Desktop Runtime"/>
                    <controls:ZInfoRow Label="{Binding [About_ArchitectureLabel], Source={x:Static services:LanguageManager.Instance}}" Value="x64 (64-bit Architecture)"/>
                    <controls:ZInfoRow Label="{Binding [About_StatusLabel], Source={x:Static services:LanguageManager.Instance}}" Value="Official Release"/>
                </StackPanel>
            </UniformGrid>

            <Separator Height="1" Background="{StaticResource ZBrushLightGray}" Margin="0,0,0,20"/>

            <!-- Footer Action Links & Close Button -->
            <Grid>
                <!-- External Links -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:ZButton Content="GitHub" Variant="Ghost" Icon="{StaticResource IconLaunch}"
                                      Command="{Binding OpenGitHubCommand}" Margin="0,0,6,0"/>
                    <controls:ZButton Content="{Binding [About_ReleasesBtn], Source={x:Static services:LanguageManager.Instance}}"
                                      Variant="Ghost" Icon="{StaticResource IconUpdate}"
                                      Command="{Binding OpenReleasesCommand}" Margin="0,0,6,0"/>
                    <controls:ZButton Content="{Binding [About_IssuesBtn], Source={x:Static services:LanguageManager.Instance}}"
                                      Variant="Ghost" Icon="{StaticResource IconWarning}"
                                      Command="{Binding OpenIssuesCommand}"/>
                </StackPanel>

                <!-- Close Button -->
                <controls:ZButton Grid.Column="1" Content="{Binding [Apps_Close], Source={x:Static services:LanguageManager.Instance}}"
                                  Variant="Secondary" HorizontalAlignment="Right"
                                  Command="{Binding CloseAboutCommand}" MinWidth="90"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
