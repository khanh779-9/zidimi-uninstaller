<UserControl x:Class="zidimi_uninstaller.Views.LeftoversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:zidimi_uninstaller.Controls"
             xmlns:services="clr-namespace:zidimi_uninstaller.Services"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="950">
    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Responsive toolbar: stats and actions no longer compete for one horizontal row. -->
        <Border Grid.Row="0"
                Background="{StaticResource ZBrushSurfaceMuted}"
                BorderBrush="{StaticResource ZBrushBorder}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <controls:ZSearchBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Placeholder="{Binding [Leftovers_SearchPlaceholder], Source={x:Static services:LanguageManager.Instance}}"
                                         MaxWidth="420"
                                         HorizontalAlignment="Stretch"
                                         Margin="0,0,12,0"/>

                    <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <controls:ZBadge Content="{Binding TotalBadgeText}" Variant="Neutral" Margin="0,0,8,0"/>
                        <controls:ZBadge Content="{Binding SelectedBadgeText}" Variant="Accent"/>
                    </WrapPanel>
                </Grid>

                <WrapPanel Grid.Row="1" Margin="0,10,0,0" HorizontalAlignment="Left">
                    <controls:ZButton Content="{Binding [Leftovers_SelectAll], Source={x:Static services:LanguageManager.Instance}}"
                                      Variant="Secondary"
                                      Icon="{StaticResource StrokeIconSelectAll}"
                                      Command="{Binding SelectAllCommand}"
                                      Margin="0,0,8,0"
                                      IsEnabled="{Binding CanOperate}"/>
                    <controls:ZButton Content="{Binding [Leftovers_SelectSafeOnly], Source={x:Static services:LanguageManager.Instance}}"
                                      Variant="Secondary"
                                      Icon="{StaticResource StrokeIconShield}"
                                      Command="{Binding SelectSafeOnlyCommand}"
                                      Margin="0,0,8,0"
                                      IsEnabled="{Binding CanOperate}"/>
                    <controls:ZButton Content="{Binding [Leftovers_ScanBtn], Source={x:Static services:LanguageManager.Instance}}"
                                      Variant="Primary"
                                      Icon="{StaticResource StrokeIconRescan}"
                                      Command="{Binding ScanCommand}"
                                      Margin="0,0,8,0"
                                      IsEnabled="{Binding CanOperate}"/>
                    <controls:ZButton Content="{Binding [Leftovers_CleanBtn], Source={x:Static services:LanguageManager.Instance}}"
                                      Variant="Danger"
                                      Icon="{StaticResource StrokeIconTrash}"
                                      Command="{Binding CleanCommand}"
                                      IsEnabled="{Binding CanOperate}"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource ZBrushSurface}"
                BorderBrush="{StaticResource ZBrushBorder}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="8,6"
                Margin="0,0,0,12">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <controls:ZButton Content="{Binding [Leftovers_FilterAll], Source={x:Static services:LanguageManager.Instance}}"
                                  Variant="Secondary" Command="{Binding FilterCommand}" CommandParameter="All" Margin="0,0,6,0"/>
                <controls:ZButton Content="{Binding [Leftovers_FilterFolders], Source={x:Static services:LanguageManager.Instance}}"
                                  Variant="Ghost" Command="{Binding FilterCommand}" CommandParameter="Folders" Margin="0,0,6,0"/>
                <controls:ZButton Content="{Binding [Leftovers_FilterRegistry], Source={x:Static services:LanguageManager.Instance}}"
                                  Variant="Ghost" Command="{Binding FilterCommand}" CommandParameter="Registry" Margin="0,0,6,0"/>
                <controls:ZButton Content="{Binding [Leftovers_FilterShortcuts], Source={x:Static services:LanguageManager.Instance}}"
                                  Variant="Ghost" Command="{Binding FilterCommand}" CommandParameter="Shortcuts" Margin="0,0,6,0"/>
                <controls:ZButton Content="{Binding [Leftovers_FilterServices], Source={x:Static services:LanguageManager.Instance}}"
                                  Variant="Ghost" Command="{Binding FilterCommand}" CommandParameter="Services" Margin="0,0,6,0"/>
                <controls:ZButton Content="{Binding [Leftovers_FilterTasks], Source={x:Static services:LanguageManager.Instance}}"
                                  Variant="Ghost" Command="{Binding FilterCommand}" CommandParameter="Tasks" Margin="0,0,6,0"/>
                <controls:ZButton Content="{Binding [Leftovers_FilterEnvironment], Source={x:Static services:LanguageManager.Instance}}"
                                  Variant="Ghost" Command="{Binding FilterCommand}" CommandParameter="Environment" Margin="0,0,6,0"/>
                <controls:ZButton Content="{Binding [Leftovers_FilterFirewall], Source={x:Static services:LanguageManager.Instance}}"
                                  Variant="Ghost" Command="{Binding FilterCommand}" CommandParameter="Firewall"/>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
            <ListBox ItemsSource="{Binding ItemsView}"
                     ItemContainerStyle="{StaticResource ZStartupListItemStyle}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource ZBrushSurface}"
                                CornerRadius="10"
                                BorderBrush="{StaticResource ZBrushBorder}"
                                BorderThickness="1"
                                Padding="10,8"
                                Margin="0,3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <controls:ZCheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                    VerticalAlignment="Center" Margin="0,0,10,0"/>

                                <controls:ZBadge Grid.Column="1"
                                                 Content="{Binding TypeText}"
                                                 Variant="Neutral"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,12,0"/>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               FontSize="13.5"
                                               Foreground="{StaticResource ZBrushBlack}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="11.5"
                                               Foreground="{StaticResource ZBrushGray}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Evidence}"
                                               FontSize="11"
                                               Foreground="{StaticResource ZBrushMidGray}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0"
                                               ToolTip="{Binding Evidence}"/>
                                    <TextBlock Text="{Binding Path}"
                                               FontSize="11.5"
                                               Foreground="{StaticResource ZBrushMidGray}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0"
                                               ToolTip="{Binding Path}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <controls:ZBadge Content="{Binding ConfidenceText}"
                                                     Variant="{Binding ConfidenceBadgeVariant}"/>
                                    <TextBlock Text="{Binding SafetyText}"
                                               FontSize="10.5"
                                               Foreground="{StaticResource ZBrushGray}"
                                               HorizontalAlignment="Center"
                                               Margin="0,3,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Column="4"
                                           Text="{Binding FormattedSize}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ZBrushGray}"
                                           VerticalAlignment="Center"
                                           MinWidth="64"
                                           TextAlignment="Right"
                                           Margin="0,0,10,0"/>

                                <controls:ZIconButton Grid.Column="5"
                                                      Icon="{StaticResource StrokeIconLaunch}"
                                                      Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"
                                                      ToolTip="{Binding [Leftovers_OpenItemTooltip], Source={x:Static services:LanguageManager.Instance}}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <controls:ZEmptyState Icon="{StaticResource StrokeIconTrash}"
                                  Title="{Binding [Leftovers_EmptyTitle], Source={x:Static services:LanguageManager.Instance}}"
                                  Subtitle="{Binding [Leftovers_EmptySubtitle], Source={x:Static services:LanguageManager.Instance}}"
                                  Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}"/>

            <controls:ZEmptyState Icon="{StaticResource StrokeIconSearch}"
                                  Title="{Binding [Leftovers_NoResultsTitle], Source={x:Static services:LanguageManager.Instance}}"
                                  Subtitle="{Binding [Leftovers_NoResultsSubtitle], Source={x:Static services:LanguageManager.Instance}}"
                                  Visibility="{Binding ShowNoResults, Converter={StaticResource BoolToVis}}"/>

            <Border Background="{StaticResource ZBrushBackground}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                    Panel.ZIndex="10">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <controls:ZProgressRing RingSize="44" IsActive="{Binding IsBusy}"/>
                    <TextBlock Text="{Binding StatusText}"
                               Margin="0,16,0,0"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ZBrushGray}"
                               FontSize="13"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" BorderBrush="{StaticResource ZBrushBorder}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="4,9,4,0">
            <TextBlock FontSize="12" Foreground="{StaticResource ZBrushGray}" Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</UserControl>
