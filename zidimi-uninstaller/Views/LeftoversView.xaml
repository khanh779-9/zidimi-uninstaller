<UserControl x:Class="zidimi_uninstaller.Views.LeftoversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:zidimi_uninstaller.Controls"
             xmlns:services="clr-namespace:zidimi_uninstaller.Services"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="950">
    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Bar: Search, Stats Badges, Actions -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search box -->
            <controls:ZSearchBox Grid.Column="0" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Placeholder="{Binding [Leftovers_SearchPlaceholder], Source={x:Static services:LanguageManager.Instance}}"
                                 Width="280"/>

            <!-- Badges -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <controls:ZBadge Content="{Binding TotalBadgeText}" Variant="Neutral" Margin="0,0,8,0"/>
                <controls:ZBadge Content="{Binding SelectedBadgeText}" Variant="Accent"/>
            </StackPanel>

            <!-- Action buttons -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <controls:ZButton Content="{Binding [Leftovers_SelectAll], Source={x:Static services:LanguageManager.Instance}}"
                                  Variant="Secondary" Command="{Binding SelectAllCommand}"
                                  Margin="0,0,8,0" IsEnabled="{Binding CanOperate}"/>
                <controls:ZButton Content="{Binding [Leftovers_SelectSafeOnly], Source={x:Static services:LanguageManager.Instance}}"
                                  Variant="Secondary" Command="{Binding SelectSafeOnlyCommand}"
                                  Margin="0,0,8,0" IsEnabled="{Binding CanOperate}"/>
                <controls:ZButton Content="{Binding [Leftovers_ScanBtn], Source={x:Static services:LanguageManager.Instance}}"
                                  Variant="Primary" Icon="{StaticResource IconSearch}"
                                  Command="{Binding ScanCommand}"
                                  Margin="0,0,8,0" IsEnabled="{Binding CanOperate}"/>
                <controls:ZButton Content="{Binding [Leftovers_CleanBtn], Source={x:Static services:LanguageManager.Instance}}"
                                  Variant="Danger" Icon="{StaticResource IconTrash}"
                                  Command="{Binding CleanCommand}"
                                  IsEnabled="{Binding CanOperate}"/>
            </StackPanel>
        </Grid>

        <!-- Filter Pills Bar -->
        <Border Grid.Row="1" Background="{StaticResource ZBrushWhite}" CornerRadius="10"
                BorderBrush="{StaticResource ZBrushLightGray}" BorderThickness="1"
                Padding="8,6" Margin="0,0,0,14">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <controls:ZButton Content="{Binding [Leftovers_FilterAll], Source={x:Static services:LanguageManager.Instance}}"
                                  Variant="Secondary" Command="{Binding FilterCommand}" CommandParameter="All"
                                  Margin="0,0,8,0"/>
                <controls:ZButton Content="{Binding [Leftovers_FilterFolders], Source={x:Static services:LanguageManager.Instance}}"
                                  Variant="Ghost" Command="{Binding FilterCommand}" CommandParameter="Folders"
                                  Margin="0,0,8,0"/>
                <controls:ZButton Content="{Binding [Leftovers_FilterRegistry], Source={x:Static services:LanguageManager.Instance}}"
                                  Variant="Ghost" Command="{Binding FilterCommand}" CommandParameter="Registry"
                                  Margin="0,0,8,0"/>
                <controls:ZButton Content="{Binding [Leftovers_FilterShortcuts], Source={x:Static services:LanguageManager.Instance}}"
                                  Variant="Ghost" Command="{Binding FilterCommand}" CommandParameter="Shortcuts"
                                  Margin="0,0,8,0"/>
            </WrapPanel>
        </Border>

        <!-- Traces List -->
        <Grid Grid.Row="2">
            <ListBox ItemsSource="{Binding ItemsView}"
                     ItemContainerStyle="{StaticResource ZStartupListItemStyle}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource ZBrushWhite}" CornerRadius="12"
                                BorderBrush="{StaticResource ZBrushLightGray}" BorderThickness="1"
                                Padding="14,10" Margin="0,3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Selection Checkbox -->
                                <controls:ZCheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                    VerticalAlignment="Center" Margin="0,0,12,0"/>

                                <!-- Type Badge -->
                                <controls:ZBadge Grid.Column="1" Content="{Binding TypeText}"
                                                 Variant="Neutral" VerticalAlignment="Center" Margin="0,0,14,0"/>

                                <!-- Name, Description & Path -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5"
                                                   Foreground="{StaticResource ZBrushBlack}" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="360"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{StaticResource ZBrushGray}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Path}" FontSize="11.5" Foreground="{StaticResource ZBrushGray}"
                                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding Path}"/>
                                </StackPanel>

                                <!-- Safety Badge -->
                                <controls:ZBadge Grid.Column="3" Content="{Binding SafetyText}"
                                                 Variant="{Binding SafetyBadgeVariant}"
                                                 VerticalAlignment="Center" Margin="0,0,14,0"/>

                                <!-- Size -->
                                <TextBlock Grid.Column="4" Text="{Binding FormattedSize}" FontSize="12.5"
                                           FontWeight="SemiBold" Foreground="{StaticResource ZBrushGray}"
                                           VerticalAlignment="Center" Width="75" TextAlignment="Right" Margin="0,0,14,0"/>

                                <!-- Open Item Button -->
                                <controls:ZIconButton Grid.Column="5" Icon="{StaticResource IconLaunch}"
                                                      Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"
                                                      ToolTip="{Binding [Leftovers_OpenItemTooltip], Source={x:Static services:LanguageManager.Instance}}"
                                                      Margin="0,0,4,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty State (Before Scan) -->
            <controls:ZEmptyState Icon="{StaticResource IconTrash}"
                                  Title="{Binding [Leftovers_EmptyTitle], Source={x:Static services:LanguageManager.Instance}}"
                                  Subtitle="{Binding [Leftovers_EmptySubtitle], Source={x:Static services:LanguageManager.Instance}}"
                                  Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}"/>

            <!-- No Results State -->
            <controls:ZEmptyState Icon="{StaticResource IconSearch}"
                                  Title="{Binding [Leftovers_NoResultsTitle], Source={x:Static services:LanguageManager.Instance}}"
                                  Subtitle="{Binding [Leftovers_NoResultsSubtitle], Source={x:Static services:LanguageManager.Instance}}"
                                  Visibility="{Binding ShowNoResults, Converter={StaticResource BoolToVis}}"/>

            <!-- Loading overlay -->
            <Border Background="{StaticResource ZBrushBackground}"
                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" Panel.ZIndex="10">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <controls:ZProgressRing RingSize="44"/>
                    <TextBlock Text="{Binding StatusText}" Margin="0,18,0,0" HorizontalAlignment="Center"
                               FontWeight="SemiBold" Foreground="{StaticResource ZBrushGray}"
                               FontSize="13"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status bar -->
        <TextBlock Grid.Row="3" Margin="6,10,6,0" FontSize="12" Foreground="{StaticResource ZBrushGray}">
            <Run Text="{Binding StatusText, Mode=OneWay}"/>
        </TextBlock>
    </Grid>
</UserControl>
