<UserControl x:Class="zidimi_uninstaller.Views.StoreAppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:zidimi_uninstaller.Controls"
             xmlns:services="clr-namespace:zidimi_uninstaller.Services"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <controls:ZSearchBox Placeholder="{Binding [Store_SearchPlaceholder], Source={x:Static services:LanguageManager.Instance}}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 MaxWidth="460" HorizontalAlignment="Left"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <controls:ZIconButton Icon="{StaticResource IconRefresh}"
                                      Command="{Binding RefreshCommand}"
                                      ToolTip="{Binding [Store_RescanTooltip], Source={x:Static services:LanguageManager.Instance}}"/>
            </StackPanel>
        </Grid>

        <!-- Action bar on selection -->
        <Border Grid.Row="1" Background="{StaticResource ZBrushAccentTint}" CornerRadius="10" Padding="16,10"
                Margin="0,0,0,12"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <Grid>
                <TextBlock Text="{Binding SelectedCountText}"
                           FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{StaticResource ZBrushAccent}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <controls:ZButton Content="{Binding [Store_UninstallSelected], Source={x:Static services:LanguageManager.Instance}}" Icon="{StaticResource IconTrash}"
                                      Command="{Binding UninstallCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- List -->
        <Grid Grid.Row="2">
            <ListBox ItemsSource="{Binding ItemsView}"
                     SelectedItem="{Binding SelectedApp}"
                     ItemContainerStyle="{StaticResource ZAppsListItemStyle}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <controls:ZAppCard Icon="{Binding Icon}"
                                           Title="{Binding DisplayName}"
                                           Subtitle="{Binding Summary}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <controls:ZCheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                    ToolTip="{Binding [Apps_SelectedCount], Source={x:Static services:LanguageManager.Instance}}"
                                                    Margin="16,0,0,0"/>
                            </StackPanel>
                        </controls:ZAppCard>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty state -->
            <controls:ZEmptyState Icon="{StaticResource IconStore}"
                                  Title="{Binding [Store_EmptyTitle], Source={x:Static services:LanguageManager.Instance}}"
                                  Subtitle="{Binding [Store_EmptySubtitle], Source={x:Static services:LanguageManager.Instance}}"
                                  Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}"/>

            <controls:ZEmptyState Icon="{StaticResource IconSearch}"
                                  Title="{Binding [Store_NoResultsTitle], Source={x:Static services:LanguageManager.Instance}}"
                                  Subtitle="{Binding [Store_NoResultsSubtitle], Source={x:Static services:LanguageManager.Instance}}"
                                  Visibility="{Binding ShowNoResults, Converter={StaticResource BoolToVis}}"/>

            <!-- Loading overlay -->
            <Border Background="{StaticResource ZBrushBackground}"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Panel.ZIndex="10">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <controls:ZProgressRing RingSize="40"/>
                    <TextBlock Text="{Binding [Store_Scanning], Source={x:Static services:LanguageManager.Instance}}" Margin="0,14,0,0" HorizontalAlignment="Center"
                               Foreground="{StaticResource ZBrushGray}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status bar -->
        <TextBlock Grid.Row="3" Margin="6,10,6,0" FontSize="12" Foreground="{StaticResource ZBrushGray}">
            <Run Text="{Binding StatusText, Mode=OneWay}"/>
        </TextBlock>
    </Grid>
</UserControl>