<UserControl x:Class="zidimi_uninstaller.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:zidimi_uninstaller.Controls"
             xmlns:services="clr-namespace:zidimi_uninstaller.Services"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <controls:ZSearchBox Placeholder="{Binding [Startup_SearchPlaceholder], Source={x:Static services:LanguageManager.Instance}}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 MaxWidth="460" HorizontalAlignment="Left"/>
            <controls:ZIconButton Grid.Column="1" Icon="{StaticResource IconRefresh}"
                                  Command="{Binding RefreshCommand}"
                                  ToolTip="{Binding [Startup_RescanTooltip], Source={x:Static services:LanguageManager.Instance}}"/>
        </Grid>

        <!-- Statistics bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <controls:ZBadge Content="{Binding TotalBadgeText}" Variant="Accent"/>
            <controls:ZBadge Content="{Binding EnabledBadgeText}" Variant="Success" Margin="8,0,0,0"/>
            <controls:ZBadge Content="{Binding DisabledBadgeText}" Variant="Danger" Margin="8,0,0,0"/>
        </StackPanel>

        <!-- List -->
        <Grid Grid.Row="2">
            <ListBox ItemsSource="{Binding ItemsView}"
                     SelectedItem="{Binding SelectedEntry}"
                     ItemContainerStyle="{StaticResource ZStartupListItemStyle}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource ZBrushWhite}" CornerRadius="12"
                                BorderBrush="{StaticResource ZBrushLightGray}" BorderThickness="1"
                                Padding="16,12" Margin="0,3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- App Icon -->
                                <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource ZBrushCard}" VerticalAlignment="Center">
                                    <Image Source="{Binding Icon}" Width="28" Height="28" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <!-- Name & Command -->
                                <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5"
                                                   Foreground="{StaticResource ZBrushBlack}" TextTrimming="CharacterEllipsis"
                                                   MaxWidth="360"/>
                                        <controls:ZBadge Content="{Binding LocationShort}" Variant="Neutral" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Command}" FontSize="12" Foreground="{StaticResource ZBrushGray}"
                                               TextTrimming="CharacterEllipsis" Margin="0,4,0,0" ToolTip="{Binding Command}"/>
                                </StackPanel>

                                <!-- Status Badge -->
                                <controls:ZBadge Grid.Column="2" Content="{Binding StatusText}"
                                                 Variant="{Binding StatusBadgeVariant}"
                                                 VerticalAlignment="Center" Margin="0,0,14,0"/>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <controls:ZIconButton Icon="{StaticResource IconInfo}"
                                                          Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"
                                                          ToolTip="{Binding [Apps_Details], Source={x:Static services:LanguageManager.Instance}}"
                                                          Margin="0,0,8,0"/>
                                    <controls:ZIconButton Icon="{StaticResource IconFolder}"
                                                          Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"
                                                          ToolTip="{Binding [Apps_OpenFolder], Source={x:Static services:LanguageManager.Instance}}"/>
                                </StackPanel>

                                <!-- Toggle Switch -->
                                <controls:ZToggleButton Grid.Column="4" VerticalAlignment="Center"
                                                        IsChecked="{Binding IsEnabled, Mode=TwoWay}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <controls:ZEmptyState Icon="{StaticResource IconStartup}"
                                  Title="{Binding [Startup_EmptyTitle], Source={x:Static services:LanguageManager.Instance}}"
                                  Subtitle="{Binding [Startup_EmptySubtitle], Source={x:Static services:LanguageManager.Instance}}"
                                  Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}"/>

            <controls:ZEmptyState Icon="{StaticResource IconSearch}"
                                  Title="{Binding [Startup_NoResultsTitle], Source={x:Static services:LanguageManager.Instance}}"
                                  Subtitle="{Binding [Startup_NoResultsSubtitle], Source={x:Static services:LanguageManager.Instance}}"
                                  Visibility="{Binding ShowNoResults, Converter={StaticResource BoolToVis}}"/>

            <!-- Loading overlay -->
            <Grid Background="#CCF2F2F2"
                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Panel.ZIndex="10">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <controls:ZProgressRing RingSize="40"/>
                    <TextBlock Text="{Binding [Startup_Scanning], Source={x:Static services:LanguageManager.Instance}}" Margin="0,14,0,0" HorizontalAlignment="Center"
                               Foreground="{StaticResource ZBrushGray}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <TextBlock Grid.Row="3" Margin="6,10,6,0" FontSize="12" Foreground="{StaticResource ZBrushGray}">
            <Run Text="{Binding StatusText, Mode=OneWay}"/>
        </TextBlock>
    </Grid>
</UserControl>