<UserControl x:Class="zidimi_uninstaller.Views.InstallMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:zidimi_uninstaller.Controls"
             xmlns:services="clr-namespace:zidimi_uninstaller.Services"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="980"
             AllowDrop="True"
             DragOver="OnDragOver"
             Drop="OnDrop">
    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource ZBrushSurfaceMuted}"
                BorderBrush="{StaticResource ZBrushBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="{Binding [InstallMonitor_CaptureTitle], Source={x:Static services:LanguageManager.Instance}}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ZBrushBlack}"
                                   VerticalAlignment="Center"/>
                        <controls:ZBadge Content="{Binding CaptureStateText, Mode=OneWay}"
                                         Variant="Accent"
                                         Margin="10,0,0,0"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding [InstallMonitor_CaptureSubtitle], Source={x:Static services:LanguageManager.Instance}}"
                               Margin="0,5,0,0"
                               FontSize="12"
                               Foreground="{StaticResource ZBrushGray}"
                               TextWrapping="Wrap"/>

                    <Border Margin="0,12,0,0"
                            Padding="10,8"
                            BorderBrush="{StaticResource ZBrushBorder}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Background="{StaticResource ZBrushSurface}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource StrokeIconFolder}"
                                  Width="18" Height="18"
                                  Margin="0,0,10,0"
                                  Stroke="{StaticResource ZBrushAccent}"
                                  StrokeThickness="1.7"
                                  Fill="Transparent"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding [InstallMonitor_DropTitle], Source={x:Static services:LanguageManager.Instance}}"
                                           FontWeight="SemiBold"
                                           FontSize="12.5"
                                           Foreground="{StaticResource ZBrushBlack}"/>
                                <TextBlock Text="{Binding [InstallMonitor_DropSubtitle], Source={x:Static services:LanguageManager.Instance}}"
                                           Margin="0,2,0,0"
                                           FontSize="11.5"
                                           Foreground="{StaticResource ZBrushGray}"/>
                            </StackPanel>
                            <controls:ZButton Grid.Column="2"
                                              Content="{Binding [InstallMonitor_ChooseInstaller], Source={x:Static services:LanguageManager.Instance}}"
                                              Variant="Secondary"
                                              Icon="{StaticResource StrokeIconFolder}"
                                              Click="OnChooseInstallerClick"
                                              IsEnabled="{Binding IsIdle}"/>
                        </Grid>
                    </Border>

                    <Grid Margin="0,11,0,0" Visibility="{Binding IsMonitoring, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="11.5" Foreground="{StaticResource ZBrushMidGray}">
                            <Run Text="{Binding [InstallMonitor_Observed], Source={x:Static services:LanguageManager.Instance}, Mode=OneWay}"/>
                            <Run Text=": "/>
                            <Run Text="{Binding ObservedChangeCount, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Margin="18,0,0,0" FontSize="11.5" Foreground="{StaticResource ZBrushMidGray}">
                            <Run Text="{Binding [InstallMonitor_Started], Source={x:Static services:LanguageManager.Instance}, Mode=OneWay}"/>
                            <Run Text=": "/>
                            <Run Text="{Binding StartedAtText, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Grid.Column="2"
                                   Text="{Binding InstallerPath, Mode=OneWay}"
                                   Margin="18,0,0,0"
                                   FontSize="11.5"
                                   Foreground="{StaticResource ZBrushMidGray}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding InstallerPath, Mode=OneWay}"/>
                    </Grid>

                    <TextBlock Text="{Binding StatusText, Mode=OneWay}"
                               Margin="0,10,0,0"
                               FontSize="11.5"
                               Foreground="{StaticResource ZBrushGray}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Top">
                    <controls:ZButton Content="{Binding [InstallMonitor_ManualCapture], Source={x:Static services:LanguageManager.Instance}}"
                                      Variant="Secondary"
                                      Icon="{StaticResource StrokeIconTarget}"
                                      Command="{Binding StartManualCaptureCommand}"
                                      MinWidth="150"/>
                    <controls:ZButton Content="{Binding [InstallMonitor_FinishCapture], Source={x:Static services:LanguageManager.Instance}}"
                                      Margin="0,8,0,0"
                                      Icon="{StaticResource StrokeIconCheck}"
                                      Command="{Binding FinishCaptureCommand}"
                                      Visibility="{Binding IsMonitoring, Converter={StaticResource BoolToVis}}"
                                      MinWidth="150"/>
                    <controls:ZButton Content="{Binding [InstallMonitor_CancelCapture], Source={x:Static services:LanguageManager.Instance}}"
                                      Margin="0,8,0,0"
                                      Variant="Ghost"
                                      Icon="{StaticResource StrokeIconClose}"
                                      Command="{Binding CancelCaptureCommand}"
                                      Visibility="{Binding IsMonitoring, Converter={StaticResource BoolToVis}}"
                                      MinWidth="150"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*" MinWidth="330"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1.25*" MinWidth="390"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource ZBrushSurface}"
                    BorderBrush="{StaticResource ZBrushBorder}"
                    BorderThickness="1"
                    CornerRadius="11"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <controls:ZSearchBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Placeholder="{Binding [InstallMonitor_SearchPlaceholder], Source={x:Static services:LanguageManager.Instance}}"
                                             Margin="0,0,8,0"/>
                        <controls:ZIconButton Grid.Column="1"
                                              Icon="{StaticResource StrokeIconRefresh}"
                                              Command="{Binding RefreshLogsCommand}"
                                              ToolTip="{Binding [InstallMonitor_Refresh], Source={x:Static services:LanguageManager.Instance}}"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ListBox ItemsSource="{Binding LogsView}"
                                 SelectedItem="{Binding SelectedLog, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource ZStartupListItemStyle}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource ZBrushSurfaceMuted}"
                                            BorderBrush="{StaticResource ZBrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="11,9"
                                            Margin="0,3">
                                        <StackPanel>
                                            <WrapPanel>
                                                <TextBlock Text="{Binding ApplicationName}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource ZBrushBlack}"
                                                           VerticalAlignment="Center"/>
                                                <controls:ZBadge Content="{Binding ResolutionText}"
                                                                 Variant="{Binding ResolutionVariant}"
                                                                 Margin="8,0,0,0"/>
                                                <controls:ZBadge Content="{Binding InstallStateText}"
                                                                 Variant="{Binding InstallStateVariant}"
                                                                 Margin="6,0,0,0"/>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding Summary}"
                                                       Margin="0,4,0,0"
                                                       FontSize="11.5"
                                                       Foreground="{StaticResource ZBrushGray}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding CompletedAtText}"
                                                       Margin="0,2,0,0"
                                                       FontSize="11"
                                                       Foreground="{StaticResource ZBrushMidGray}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <controls:ZEmptyState Icon="{StaticResource StrokeIconMemory}"
                                              Title="{Binding [InstallMonitor_EmptyTitle], Source={x:Static services:LanguageManager.Instance}}"
                                              Subtitle="{Binding [InstallMonitor_EmptySubtitle], Source={x:Static services:LanguageManager.Instance}}"
                                              Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}"/>
                        <controls:ZEmptyState Icon="{StaticResource StrokeIconSearch}"
                                              Title="{Binding [InstallMonitor_NoResultsTitle], Source={x:Static services:LanguageManager.Instance}}"
                                              Subtitle="{Binding [InstallMonitor_NoResultsSubtitle], Source={x:Static services:LanguageManager.Instance}}"
                                              Visibility="{Binding ShowNoResults, Converter={StaticResource BoolToVis}}"/>
                    </Grid>

                    <Grid Grid.Row="2" Margin="3,9,3,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="11.5" Foreground="{StaticResource ZBrushGray}">
                            <Run Text="{Binding VisibleLogCount, Mode=OneWay}"/>
                            <Run Text="/"/>
                            <Run Text="{Binding TotalLogCount, Mode=OneWay}"/>
                        </TextBlock>
                        <controls:ZButton Grid.Column="1"
                                          Content="{Binding [InstallMonitor_OpenFolder], Source={x:Static services:LanguageManager.Instance}}"
                                          Variant="Ghost"
                                          Icon="{StaticResource StrokeIconFolder}"
                                          Command="{Binding OpenLogFolderCommand}"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource ZBrushSurface}"
                    BorderBrush="{StaticResource ZBrushBorder}"
                    BorderThickness="1"
                    CornerRadius="11"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Visibility="{Binding HasSelectedLog, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedLog.ApplicationName}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ZBrushBlack}"/>
                            <TextBlock Text="{Binding SelectedLog.Summary}"
                                       Margin="0,4,0,0"
                                       FontSize="11.5"
                                       Foreground="{StaticResource ZBrushGray}"/>
                            <TextBlock Text="{Binding SelectedLog.InstallLocation}"
                                       Margin="0,3,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource ZBrushMidGray}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SelectedLog.InstallLocation}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                            <controls:ZButton Content="{Binding [InstallMonitor_Rollback], Source={x:Static services:LanguageManager.Instance}}"
                                              Variant="Primary"
                                              Icon="{StaticResource StrokeIconRestore}"
                                              Command="{Binding RollbackSelectedLogCommand}"
                                              IsEnabled="{Binding CanRollbackSelectedLog}"
                                              Margin="0,0,7,0"/>
                            <controls:ZButton Content="{Binding [InstallMonitor_ScanLeftovers], Source={x:Static services:LanguageManager.Instance}}"
                                              Variant="Secondary"
                                              Icon="{StaticResource StrokeIconRescan}"
                                              Command="{Binding ScanSelectedLogCommand}"
                                              IsEnabled="{Binding CanScanSelectedLog}"
                                              Margin="0,0,7,0"/>
                            <controls:ZIconButton Icon="{StaticResource StrokeIconTrash}"
                                                  Command="{Binding DeleteSelectedLogCommand}"
                                                  ToolTip="{Binding [InstallMonitor_Delete], Source={x:Static services:LanguageManager.Instance}}"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,12,0,10"
                            Height="1"
                            Background="{StaticResource ZBrushBorder}"
                            Visibility="{Binding HasSelectedLog, Converter={StaticResource BoolToVis}}"/>

                    <Grid Grid.Row="2">
                        <ListBox ItemsSource="{Binding SelectedArtifacts}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Visibility="{Binding HasSelectedLog, Converter={StaticResource BoolToVis}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="9,7"
                                            Margin="0,2"
                                            CornerRadius="7"
                                            Background="{StaticResource ZBrushSurfaceMuted}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <controls:ZBadge Content="{Binding TypeText}"
                                                             Variant="Neutral"
                                                             Margin="0,0,9,0"
                                                             VerticalAlignment="Top"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource ZBrushBlack}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Path}"
                                                           Margin="0,2,0,0"
                                                           FontSize="10.8"
                                                           Foreground="{StaticResource ZBrushGray}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Path}"/>
                                                <TextBlock Text="{Binding Evidence}"
                                                           Margin="0,2,0,0"
                                                           FontSize="10.5"
                                                           Foreground="{StaticResource ZBrushMidGray}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="8,0,0,0" HorizontalAlignment="Right">
                                                <controls:ZBadge Content="{Binding ConfidenceText}"
                                                                 Variant="{Binding ConfidenceVariant}"/>
                                                <TextBlock Text="{Binding ChangeText}"
                                                           Margin="0,4,0,0"
                                                           FontSize="10.5"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{StaticResource ZBrushMidGray}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <controls:ZEmptyState Icon="{StaticResource StrokeIconInfo}"
                                              Title="{Binding [InstallMonitor_SelectLogTitle], Source={x:Static services:LanguageManager.Instance}}"
                                              Subtitle="{Binding [InstallMonitor_SelectLogSubtitle], Source={x:Static services:LanguageManager.Instance}}"
                                              Visibility="{Binding HasSelectedLog, Converter={StaticResource InverseBoolToVis}}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
