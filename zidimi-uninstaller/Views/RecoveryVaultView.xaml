<UserControl x:Class="zidimi_uninstaller.Views.RecoveryVaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:zidimi_uninstaller.Controls"
             xmlns:services="clr-namespace:zidimi_uninstaller.Services"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="950">
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource ZBrushSurfaceMuted}"
                BorderBrush="{StaticResource ZBrushBorder}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <controls:ZSearchBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Placeholder="{Binding [RecoveryVault_SearchPlaceholder], Source={x:Static services:LanguageManager.Instance}}"
                                     MaxWidth="440"
                                     HorizontalAlignment="Stretch"
                                     Margin="0,0,12,0"/>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <controls:ZButton Content="{Binding [RecoveryVault_OpenFolder], Source={x:Static services:LanguageManager.Instance}}"
                                      Variant="Secondary"
                                      Icon="{StaticResource StrokeIconFolder}"
                                      Command="{Binding OpenFolderCommand}"
                                      Margin="0,0,8,0"/>
                    <controls:ZButton Content="{Binding [RecoveryVault_ClearRestored], Source={x:Static services:LanguageManager.Instance}}"
                                      Variant="Ghost"
                                      Icon="{StaticResource StrokeIconTrash}"
                                      Command="{Binding ClearRestoredCommand}"
                                      Margin="0,0,8,0"/>
                    <controls:ZButton Content="{Binding [RecoveryVault_Refresh], Source={x:Static services:LanguageManager.Instance}}"
                                      Variant="Secondary"
                                      Icon="{StaticResource StrokeIconRefresh}"
                                      Command="{Binding RefreshCommand}"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.88*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.12*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource ZBrushSurface}"
                    BorderBrush="{StaticResource ZBrushBorder}"
                    BorderThickness="1"
                    CornerRadius="11"
                    Padding="10">
                <Grid>
                    <ListBox ItemsSource="{Binding EntriesView}"
                             SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,9"
                                        Margin="0,2"
                                        CornerRadius="8"
                                        Background="{StaticResource ZBrushSurfaceMuted}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource ZBrushBlack}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Margin="0,3,0,0" FontSize="10.8" Foreground="{StaticResource ZBrushGray}">
                                                <Run Text="{Binding CreatedAtText, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding Operation, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Summary}"
                                                       Margin="0,3,0,0"
                                                       FontSize="10.8"
                                                       Foreground="{StaticResource ZBrushMidGray}"/>
                                        </StackPanel>
                                        <controls:ZBadge Grid.Column="1"
                                                         Content="{Binding StatusText}"
                                                         Variant="{Binding StatusVariant}"
                                                         Margin="8,0,0,0"
                                                         VerticalAlignment="Top"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <controls:ZEmptyState Icon="{StaticResource StrokeIconRestore}"
                                          Title="{Binding [RecoveryVault_EmptyTitle], Source={x:Static services:LanguageManager.Instance}}"
                                          Subtitle="{Binding [RecoveryVault_EmptySubtitle], Source={x:Static services:LanguageManager.Instance}}"
                                          Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}"/>
                    <controls:ZEmptyState Icon="{StaticResource StrokeIconSearch}"
                                          Title="{Binding [RecoveryVault_NoResultsTitle], Source={x:Static services:LanguageManager.Instance}}"
                                          Subtitle="{Binding [RecoveryVault_NoResultsSubtitle], Source={x:Static services:LanguageManager.Instance}}"
                                          Visibility="{Binding ShowNoResults, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource ZBrushSurface}"
                    BorderBrush="{StaticResource ZBrushBorder}"
                    BorderThickness="1"
                    CornerRadius="11"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Visibility="{Binding HasSelectedEntry, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedEntry.Title}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource ZBrushBlack}"/>
                            <TextBlock Text="{Binding SelectedEntry.ApplicationName}"
                                       Margin="0,3,0,0"
                                       FontSize="11.5"
                                       Foreground="{StaticResource ZBrushGray}"/>
                            <TextBlock Text="{Binding SelectedEntry.LastError}"
                                       Margin="0,4,0,0"
                                       FontSize="10.8"
                                       Foreground="{StaticResource ZBrushAccent}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <WrapPanel Grid.Column="1" Margin="12,0,0,0">
                            <controls:ZButton Content="{Binding [RecoveryVault_Restore], Source={x:Static services:LanguageManager.Instance}}"
                                              Variant="Primary"
                                              Icon="{StaticResource StrokeIconRestore}"
                                              IsEnabled="{Binding CanRestoreSelected}"
                                              Command="{Binding RestoreSelectedCommand}"
                                              Margin="0,0,7,0"/>
                            <controls:ZIconButton Icon="{StaticResource StrokeIconTrash}"
                                                  Command="{Binding DeleteSelectedCommand}"
                                                  ToolTip="{Binding [RecoveryVault_Delete], Source={x:Static services:LanguageManager.Instance}}"/>
                        </WrapPanel>
                    </Grid>

                    <Border Grid.Row="1" Height="1" Margin="0,12,0,10"
                            Background="{StaticResource ZBrushBorder}"
                            Visibility="{Binding HasSelectedEntry, Converter={StaticResource BoolToVis}}"/>

                    <Grid Grid.Row="2">
                        <ListBox ItemsSource="{Binding SelectedArtifacts}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Visibility="{Binding HasSelectedEntry, Converter={StaticResource BoolToVis}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="9,7" Margin="0,2" CornerRadius="7"
                                            Background="{StaticResource ZBrushSurfaceMuted}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <controls:ZBadge Content="{Binding TypeText}" Variant="Neutral"
                                                             Margin="0,0,9,0" VerticalAlignment="Top"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource ZBrushBlack}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding OriginalPath}"
                                                           Margin="0,2,0,0" FontSize="10.8"
                                                           Foreground="{StaticResource ZBrushGray}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding OriginalPath}"/>
                                                <TextBlock Text="{Binding Note}"
                                                           Margin="0,2,0,0" FontSize="10.5"
                                                           Foreground="{StaticResource ZBrushMidGray}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding RestoreError}"
                                                           Margin="0,2,0,0" FontSize="10.5"
                                                           Foreground="{StaticResource ZBrushAccent}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <controls:ZBadge Grid.Column="2"
                                                             Content="{Binding StateText}"
                                                             Variant="{Binding StateVariant}"
                                                             Margin="8,0,0,0"
                                                             VerticalAlignment="Top"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <controls:ZEmptyState Icon="{StaticResource StrokeIconInfo}"
                                              Title="{Binding [RecoveryVault_SelectTitle], Source={x:Static services:LanguageManager.Instance}}"
                                              Subtitle="{Binding [RecoveryVault_SelectSubtitle], Source={x:Static services:LanguageManager.Instance}}"
                                              Visibility="{Binding HasSelectedEntry, Converter={StaticResource InverseBoolToVis}}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="{StaticResource ZBrushBorder}"
                BorderThickness="0,1,0,0"
                Margin="0,10,0,0"
                Padding="4,9,4,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}"
                           FontSize="12" Foreground="{StaticResource ZBrushGray}"/>
                <TextBlock Grid.Column="1" FontSize="12" Foreground="{StaticResource ZBrushGray}">
                    <Run Text="{Binding VisibleCount, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding TotalCount, Mode=OneWay}"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
