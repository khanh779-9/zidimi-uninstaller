<UserControl x:Class="zidimi_uninstaller.Views.BrowserExtensionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:zidimi_uninstaller.Controls"
             xmlns:services="clr-namespace:zidimi_uninstaller.Services"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <controls:ZStatCard Grid.Column="0" Margin="4"
                                Icon="{StaticResource StrokeIconGlobe}"
                                IconBrush="{StaticResource ZBrushAccent}"
                                Value="{Binding TotalCount}"
                                Label="{Binding [BrowserExtensions_Total], Source={x:Static services:LanguageManager.Instance}}"/>
            <controls:ZStatCard Grid.Column="1" Margin="4"
                                Icon="{StaticResource StrokeIconCheck}"
                                IconBrush="{StaticResource ZBrushDarkGray}"
                                Value="{Binding EnabledCount}"
                                Label="{Binding [BrowserExtensions_Enabled], Source={x:Static services:LanguageManager.Instance}}"/>
            <controls:ZStatCard Grid.Column="2" Margin="4"
                                Icon="{StaticResource StrokeIconWarning}"
                                IconBrush="{StaticResource ZBrushBrown}"
                                Value="{Binding ElevatedCount}"
                                Label="{Binding [BrowserExtensions_Elevated], Source={x:Static services:LanguageManager.Instance}}"/>
            <controls:ZStatCard Grid.Column="3" Margin="4"
                                Icon="{StaticResource StrokeIconMemory}"
                                IconBrush="{StaticResource ZBrushMidGray}"
                                Value="{Binding UnpackedCount}"
                                Label="{Binding [BrowserExtensions_Unpacked], Source={x:Static services:LanguageManager.Instance}}"/>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,14,0,0"
                Padding="12"
                Background="{StaticResource ZBrushSurfaceMuted}"
                BorderBrush="{StaticResource ZBrushBorder}"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <controls:ZSearchBox Grid.Column="0"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Placeholder="{Binding [BrowserExtensions_Search], Source={x:Static services:LanguageManager.Instance}}"/>
                <WrapPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                    <controls:ZToggleButton Content="{Binding [BrowserExtensions_FilterAll], Source={x:Static services:LanguageManager.Instance}}"
                                            IsChecked="{Binding IsFilterAll, Mode=OneWay}"
                                            Command="{Binding FilterCommand}" CommandParameter="All" Margin="0,0,6,0"/>
                    <controls:ZToggleButton Content="{Binding [BrowserExtensions_FilterEnabled], Source={x:Static services:LanguageManager.Instance}}"
                                            IsChecked="{Binding IsFilterEnabled, Mode=OneWay}"
                                            Command="{Binding FilterCommand}" CommandParameter="Enabled" Margin="0,0,6,0"/>
                    <controls:ZToggleButton Content="{Binding [BrowserExtensions_FilterElevated], Source={x:Static services:LanguageManager.Instance}}"
                                            IsChecked="{Binding IsFilterElevated, Mode=OneWay}"
                                            Command="{Binding FilterCommand}" CommandParameter="Elevated" Margin="0,0,6,0"/>
                    <controls:ZToggleButton Content="{Binding [BrowserExtensions_FilterUnpacked], Source={x:Static services:LanguageManager.Instance}}"
                                            IsChecked="{Binding IsFilterUnpacked, Mode=OneWay}"
                                            Command="{Binding FilterCommand}" CommandParameter="Unpacked"/>
                </WrapPanel>
                <controls:ZButton Grid.Column="2"
                                  Content="{Binding [BrowserExtensions_Rescan], Source={x:Static services:LanguageManager.Instance}}"
                                  Icon="{StaticResource StrokeIconRescan}"
                                  Command="{Binding RescanCommand}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="0.75*"/>
            </Grid.ColumnDefinitions>

            <controls:ZCard Grid.Column="0" Padding="10">
                <Grid>
                    <ListBox ItemsSource="{Binding ItemsView}"
                             SelectedItem="{Binding SelectedExtension, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,3" Padding="10,9"
                                        Background="{StaticResource ZBrushSurfaceMuted}"
                                        CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource ZBrushBlack}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Summary}" Margin="0,3,0,0" FontSize="11"
                                                       Foreground="{StaticResource ZBrushGray}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding RiskSignalSummary}" Margin="0,3,0,0" FontSize="10.7"
                                                       Foreground="{StaticResource ZBrushMidGray}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" HorizontalAlignment="Right">
                                            <controls:ZBadge Content="{Binding RiskText}" Variant="{Binding RiskBadgeVariant}"/>
                                            <controls:ZBadge Content="{Binding StatusText}" Variant="{Binding StatusBadgeVariant}" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <controls:ZEmptyState Icon="{StaticResource StrokeIconGlobe}"
                                          Title="{Binding [BrowserExtensions_EmptyTitle], Source={x:Static services:LanguageManager.Instance}}"
                                          Subtitle="{Binding [BrowserExtensions_EmptySubtitle], Source={x:Static services:LanguageManager.Instance}}"
                                          Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}"/>
                    <controls:ZEmptyState Icon="{StaticResource StrokeIconSearch}"
                                          Title="{Binding [BrowserExtensions_NoResultsTitle], Source={x:Static services:LanguageManager.Instance}}"
                                          Subtitle="{Binding [BrowserExtensions_NoResultsSubtitle], Source={x:Static services:LanguageManager.Instance}}"
                                          Visibility="{Binding ShowNoResults, Converter={StaticResource BoolToVis}}"/>
                    <Border Background="#AAFFFFFF" CornerRadius="10"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <controls:ZProgressRing RingSize="38" IsActive="{Binding IsLoading}"/>
                            <TextBlock Text="{Binding [BrowserExtensions_Scanning], Source={x:Static services:LanguageManager.Instance}}"
                                       Margin="0,12,0,0" Foreground="{StaticResource ZBrushGray}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </controls:ZCard>

            <controls:ZCard Grid.Column="2" Padding="16">
                <Grid>
                    <Grid Visibility="{Binding HasSelectedExtension, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="{Binding SelectedExtension.Name}" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource ZBrushBlack}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedExtension.Description}" Margin="0,5,0,0"
                                       FontSize="11.5" Foreground="{StaticResource ZBrushGray}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <WrapPanel Grid.Row="1" Margin="0,12,0,0">
                            <controls:ZBadge Content="{Binding SelectedExtension.BrowserName}" Variant="Accent" Margin="0,0,6,5"/>
                            <controls:ZBadge Content="{Binding SelectedExtension.ProfileName}" Variant="Neutral" Margin="0,0,6,5"/>
                            <controls:ZBadge Content="{Binding SelectedExtension.RiskText}" Variant="{Binding SelectedExtension.RiskBadgeVariant}" Margin="0,0,6,5"/>
                        </WrapPanel>
                        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                            <TextBlock Text="{Binding SelectedExtension.Id, StringFormat=ID: {0}}" FontSize="11" Foreground="{StaticResource ZBrushMidGray}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SelectedExtension.ExtensionPath}" Margin="0,3,0,0" FontSize="10.5"
                                       Foreground="{StaticResource ZBrushGray}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Row="3" Margin="0,12,0,10" Height="1" Background="{StaticResource ZBrushBorder}"/>
                        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{Binding [BrowserExtensions_Permissions], Source={x:Static services:LanguageManager.Instance}}"
                                           FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ZBrushBlack}"/>
                                <ItemsControl ItemsSource="{Binding SelectedExtension.Permissions}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:ZBadge Content="{Binding}" Variant="Neutral" Margin="0,0,5,5" HorizontalAlignment="Left"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock Text="{Binding [BrowserExtensions_HostAccess], Source={x:Static services:LanguageManager.Instance}}"
                                           Margin="0,8,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ZBrushBlack}"/>
                                <ItemsControl ItemsSource="{Binding SelectedExtension.HostPermissions}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Margin="0,0,0,4" FontSize="10.6" Foreground="{StaticResource ZBrushGray}" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding [BrowserExtensions_RiskSignals], Source={x:Static services:LanguageManager.Instance}}"
                                           Margin="0,8,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ZBrushBlack}"/>
                                <TextBlock Text="{Binding SelectedExtension.RiskSignalSummary}" Margin="0,5,0,0" FontSize="10.8"
                                           Foreground="{StaticResource ZBrushGray}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding [BrowserExtensions_RiskDisclaimer], Source={x:Static services:LanguageManager.Instance}}"
                                           Margin="0,9,0,0" FontSize="10.4" Foreground="{StaticResource ZBrushMidGray}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                        <WrapPanel Grid.Row="5" Margin="0,12,0,0">
                            <controls:ZButton Content="{Binding [BrowserExtensions_OpenManager], Source={x:Static services:LanguageManager.Instance}}"
                                              Icon="{StaticResource StrokeIconLaunch}"
                                              Command="{Binding OpenManagerCommand}" CommandParameter="{Binding SelectedExtension}" Margin="0,0,7,0"/>
                            <controls:ZButton Content="{Binding [BrowserExtensions_OpenFolder], Source={x:Static services:LanguageManager.Instance}}"
                                              Variant="Secondary" Icon="{StaticResource StrokeIconFolder}"
                                              Command="{Binding OpenFolderCommand}" CommandParameter="{Binding SelectedExtension}"/>
                        </WrapPanel>
                    </Grid>

                    <controls:ZEmptyState Icon="{StaticResource StrokeIconInfo}"
                                          Title="{Binding [BrowserExtensions_SelectTitle], Source={x:Static services:LanguageManager.Instance}}"
                                          Subtitle="{Binding [BrowserExtensions_SelectSubtitle], Source={x:Static services:LanguageManager.Instance}}"
                                          Visibility="{Binding HasSelectedExtension, Converter={StaticResource InverseBoolToVis}}"/>
                </Grid>
            </controls:ZCard>
        </Grid>

        <TextBlock Grid.Row="3" Margin="4,10,0,0" FontSize="11" Foreground="{StaticResource ZBrushGray}">
            <Run Text="{Binding VisibleCount, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding TotalCount, Mode=OneWay}"/>
            <Run Text="  ·  "/><Run Text="{Binding StatusText, Mode=OneWay}"/>
        </TextBlock>
    </Grid>
</UserControl>
