<UserControl x:Class="zidimi_uninstaller.Views.DeepCleanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:zidimi_uninstaller.Controls"
             xmlns:models="clr-namespace:zidimi_uninstaller.Models"
             xmlns:services="clr-namespace:zidimi_uninstaller.Services"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Border Background="{StaticResource ZBrushWhite}" CornerRadius="16" BorderBrush="{StaticResource ZBrushLightGray}"
            BorderThickness="1" Padding="24" MaxWidth="760" MaxHeight="600">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.2" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource ZBrushAccentTint}" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconTrash}" Fill="{StaticResource ZBrushAccent}" Stretch="Uniform" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="{StaticResource ZBrushBlack}">
                        <Run Text="Deep Clean: "/>
                        <Run Text="{Binding AppName, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock FontSize="13" Foreground="{StaticResource ZBrushGray}" Margin="0,3,0,0">
                        <Run Text="{Binding TotalFound, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text=" items  ·  "/>
                        <Run Text="{Binding TotalSizeText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource ZBrushAccent}"/>
                    </TextBlock>
                </StackPanel>

                <controls:ZIconButton Grid.Column="2" Icon="{StaticResource IconClose}"
                                      Command="{Binding CloseCommand}"
                                      ToolTip="{Binding [DeepClean_Skip], Source={x:Static services:LanguageManager.Instance}}"/>
            </Grid>

            <!-- Items List -->
            <Border Grid.Row="1" Background="{StaticResource ZBrushCard}" CornerRadius="10" Padding="8" Margin="0,0,0,16">
                <ListBox ItemsSource="{Binding Items}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:LeftoverItem}">
                            <Border Background="{StaticResource ZBrushWhite}" CornerRadius="8" Padding="12,10" Margin="0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <controls:ZCheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                        VerticalAlignment="Center" Margin="0,0,12,0"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{StaticResource ZBrushBlack}"/>
                                            <TextBlock Text="{Binding FormattedSize, StringFormat=' ({0})'}"
                                                       FontSize="12" Foreground="{StaticResource ZBrushGray}"
                                                       Visibility="{Binding FormattedSize, Converter={StaticResource NullEmptyToVis}, ConverterParameter=False}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{StaticResource ZBrushMidGray}"
                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Path}"/>
                                    </StackPanel>

                                    <controls:ZBadge Grid.Column="2" Content="{Binding TypeText}" Variant="Neutral"
                                                     VerticalAlignment="Center" Margin="10,0"/>

                                    <controls:ZBadge Grid.Column="3" Content="{Binding SafetyText}"
                                                     Variant="{Binding SafetyBadgeVariant}"
                                                     VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Footer Toolbar -->
            <Grid Grid.Row="2">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:ZButton Content="{Binding [DeepClean_SelectAll], Source={x:Static services:LanguageManager.Instance}}" Variant="Ghost"
                                      Command="{Binding SelectAllCommand}"
                                      Margin="0,0,8,0"/>
                    <controls:ZButton Content="{Binding [DeepClean_SelectSafeOnly], Source={x:Static services:LanguageManager.Instance}}" Variant="Ghost"
                                      Command="{Binding SelectSafeOnlyCommand}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <controls:ZButton Content="{Binding [DeepClean_Skip], Source={x:Static services:LanguageManager.Instance}}" Variant="Secondary"
                                      Command="{Binding CloseCommand}"
                                      Margin="0,0,10,0"/>
                    <controls:ZButton Content="{Binding SelectedCount, StringFormat={}{0} items}"
                                      Variant="Danger"
                                      Icon="{StaticResource IconTrash}"
                                      Command="{Binding CleanCommand}"
                                      IsEnabled="{Binding SelectedCount, Converter={StaticResource IntToVis}}"/>
                </StackPanel>
            </Grid>

            <!-- Cleaning Progress Overlay -->
            <Border Grid.Row="0" Grid.RowSpan="3" Background="#D9FFFFFF" CornerRadius="16"
                    Visibility="{Binding IsCleaning, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <controls:ZProgressRing RingSize="44"/>
                    <TextBlock Text="{Binding [DeepClean_CleaningProgress], Source={x:Static services:LanguageManager.Instance}}" Margin="0,16,0,0"
                               Foreground="{StaticResource ZBrushGray}" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
