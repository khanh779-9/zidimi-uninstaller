<UserControl x:Class="zidimi_uninstaller.Views.ApplicationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:zidimi_uninstaller.Controls"
             xmlns:services="clr-namespace:zidimi_uninstaller.Services"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="950">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <controls:ZSearchBox Placeholder="{Binding [Apps_SearchPlaceholder], Source={x:Static services:LanguageManager.Instance}}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     MaxWidth="460" HorizontalAlignment="Left"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ComboBox ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSort}"
                              DisplayMemberPath="Label"
                              Width="160" VerticalAlignment="Center"/>
                    <controls:ZIconButton Icon="{StaticResource IconRefresh}"
                                          Command="{Binding RefreshCommand}"
                                          ToolTip="{Binding [Sidebar_ReloadAll], Source={x:Static services:LanguageManager.Instance}}"
                                          Margin="10,0,0,0"/>
                    <controls:ZIconButton Icon="{StaticResource IconCheck}"
                                          Command="{Binding SelectAllCommand}"
                                          ToolTip="{Binding [DeepClean_SelectAll], Source={x:Static services:LanguageManager.Instance}}"
                                          Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Filter Pills -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <controls:ZButton Content="{Binding [Apps_FilterAll], Source={x:Static services:LanguageManager.Instance}}" Variant="Ghost" Margin="0,0,6,0"
                                  Command="{Binding SetFilterCategoryCommand}" CommandParameter="All"/>
                <controls:ZButton Content="{Binding [Apps_Filter64Bit], Source={x:Static services:LanguageManager.Instance}}" Variant="Ghost" Margin="0,0,6,0"
                                  Command="{Binding SetFilterCategoryCommand}" CommandParameter="64Bit"/>
                <controls:ZButton Content="{Binding [Apps_Filter32Bit], Source={x:Static services:LanguageManager.Instance}}" Variant="Ghost" Margin="0,0,6,0"
                                  Command="{Binding SetFilterCategoryCommand}" CommandParameter="32Bit"/>
                <controls:ZButton Content="{Binding [Apps_FilterLarge], Source={x:Static services:LanguageManager.Instance}}" Variant="Ghost" Margin="0,0,6,0"
                                  Command="{Binding SetFilterCategoryCommand}" CommandParameter="Large"/>
                <controls:ZButton Content="{Binding [Apps_FilterRecent], Source={x:Static services:LanguageManager.Instance}}" Variant="Ghost" Margin="0,0,6,0"
                                  Command="{Binding SetFilterCategoryCommand}" CommandParameter="Recent"/>
                <controls:ZButton Content="{Binding [Apps_FilterBroken], Source={x:Static services:LanguageManager.Instance}}" Variant="Ghost"
                                  Command="{Binding SetFilterCategoryCommand}" CommandParameter="Broken"/>
            </StackPanel>
        </StackPanel>

        <!-- Action bar on multi-selection -->
        <Border Grid.Row="1" Background="{StaticResource ZBrushAccentTint}" CornerRadius="10" Padding="16,10"
                Margin="0,0,0,12"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <Grid>
                <TextBlock Text="{Binding SelectedCount, StringFormat={}{0} apps selected}"
                           FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{StaticResource ZBrushAccent}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <controls:ZButton Content="{Binding [Apps_QuietUninstall], Source={x:Static services:LanguageManager.Instance}}" Variant="Secondary"
                                      Command="{Binding QuietUninstallCommand}"
                                      Margin="0,0,8,0"/>
                    <controls:ZButton Content="{Binding [Apps_Uninstall], Source={x:Static services:LanguageManager.Instance}}" Icon="{StaticResource IconTrash}"
                                      Command="{Binding UninstallCommand}"/>
                    <controls:ZIconButton Icon="{StaticResource IconClose}"
                                          Command="{Binding ClearSelectionCommand}"
                                          ToolTip="{Binding [DeepClean_Skip], Source={x:Static services:LanguageManager.Instance}}"
                                          Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Applications list & Floating Bar -->
        <Grid Grid.Row="2">
            <ListBox ItemsSource="{Binding ItemsView}"
                     SelectedItem="{Binding SelectedApp}"
                     ItemContainerStyle="{StaticResource ZAppsListItemStyle}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <controls:ZAppCard Icon="{Binding Icon}"
                                           Title="{Binding DisplayName}"
                                           Subtitle="{Binding Summary}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <controls:ZBadge Content="{Binding [Apps_BrokenBadge], Source={x:Static services:LanguageManager.Instance}}" Variant="Danger" Margin="0,0,8,0"
                                                 Visibility="{Binding IsBroken, Converter={StaticResource BoolToVis}}"/>
                                <controls:ZBadge Content="{Binding KindText}"
                                                 Variant="{Binding Kind, Converter={StaticResource KindToBadge}}"/>
                                <controls:ZIconButton Icon="{StaticResource IconInfo}"
                                                      Margin="10,0,0,0"
                                                      ToolTip="{Binding [Apps_Details], Source={x:Static services:LanguageManager.Instance}}"
                                                      Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                <controls:ZCheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                    ToolTip="{Binding [Apps_SelectedCount], Source={x:Static services:LanguageManager.Instance}}"
                                                    Margin="12,0,0,0"/>
                            </StackPanel>
                        </controls:ZAppCard>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Compact Floating Action Bar at the bottom when an item is clicked -->
            <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="8,0,8,8"
                    Background="{StaticResource ZBrushWhite}" CornerRadius="12"
                    BorderBrush="{StaticResource ZBrushLightGray}" BorderThickness="1"
                    Padding="16,10"
                    Visibility="{Binding SelectedApp, Converter={StaticResource NotNullToVis}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.14" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource ZBrushCard}" VerticalAlignment="Center">
                            <Image Source="{Binding SelectedApp.Icon}" Width="22" Height="22" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedApp.DisplayName}" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{StaticResource ZBrushBlack}" MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding SelectedApp.Summary}" FontSize="11" Foreground="{StaticResource ZBrushGray}"
                                       MaxWidth="280" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:ZButton Content="{Binding [Apps_Uninstall], Source={x:Static services:LanguageManager.Instance}}" Icon="{StaticResource IconTrash}"
                                          Command="{Binding UninstallCommand}"/>
                        <controls:ZButton Content="{Binding [Apps_QuietUninstall], Source={x:Static services:LanguageManager.Instance}}" Variant="Secondary"
                                          Command="{Binding QuietUninstallCommand}"
                                          Margin="8,0,0,0"/>
                        <controls:ZButton Content="{Binding [Apps_DeepClean], Source={x:Static services:LanguageManager.Instance}}" Variant="Secondary" Icon="{StaticResource IconSearch}"
                                          Command="{Binding DeepCleanSelectedCommand}"
                                          Margin="8,0,0,0"/>
                        <controls:ZButton Content="{Binding [Apps_Details], Source={x:Static services:LanguageManager.Instance}}" Variant="Ghost" Icon="{StaticResource IconInfo}"
                                          Command="{Binding OpenDetailsCommand}"
                                          CommandParameter="{Binding SelectedApp}"
                                          Margin="8,0,0,0"/>
                        <controls:ZIconButton Icon="{StaticResource IconClose}"
                                              Margin="8,0,0,0"
                                              Command="{Binding ClearSelectionCommand}"
                                              ToolTip="{Binding [Apps_CloseActionBar], Source={x:Static services:LanguageManager.Instance}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Empty state -->
            <controls:ZEmptyState Icon="{StaticResource IconApps}"
                                  Title="{Binding [Apps_EmptyTitle], Source={x:Static services:LanguageManager.Instance}}"
                                  Subtitle="{Binding [Apps_EmptySubtitle], Source={x:Static services:LanguageManager.Instance}}"
                                  Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}"/>
            <controls:ZEmptyState Icon="{StaticResource IconSearch}"
                                  Title="{Binding [Apps_NoResultsTitle], Source={x:Static services:LanguageManager.Instance}}"
                                  Subtitle="{Binding [Apps_NoResultsSubtitle], Source={x:Static services:LanguageManager.Instance}}"
                                  Visibility="{Binding ShowNoResults, Converter={StaticResource BoolToVis}}"/>

            <!-- Loading -->
            <Grid Background="#CCF2F2F2"
                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Panel.ZIndex="10">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <controls:ZProgressRing RingSize="40"/>
                    <TextBlock Text="{Binding [Apps_Scanning], Source={x:Static services:LanguageManager.Instance}}" Margin="0,14,0,0" HorizontalAlignment="Center"
                               Foreground="{StaticResource ZBrushGray}"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="3" Margin="6,10,6,0">
            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource ZBrushGray}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock FontSize="12" Foreground="{StaticResource ZBrushGray}" VerticalAlignment="Center">
                    <Run Text="{Binding VisibleCount, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding TotalCount, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>