<UserControl x:Class="zidimi_uninstaller.Views.ApplicationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:zidimi_uninstaller.Controls"
             xmlns:services="clr-namespace:zidimi_uninstaller.Services"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="950">
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search / sort / actions -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <controls:ZSearchBox Placeholder="{Binding [Apps_SearchPlaceholder], Source={x:Static services:LanguageManager.Instance}}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     MaxWidth="440"
                                     HorizontalAlignment="Stretch"
                                     Margin="0,0,12,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ComboBox ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSort}"
                              DisplayMemberPath="Label"
                              Width="156"
                              VerticalAlignment="Center"/>
                    <controls:ZIconButton Icon="{StaticResource StrokeIconRescan}"
                                          Command="{Binding RescanCommand}"
                                          ToolTip="{Binding [Dashboard_Rescan], Source={x:Static services:LanguageManager.Instance}}"
                                          Margin="8,0,0,0"/>
                    <controls:ZIconButton Icon="{StaticResource StrokeIconSelectAll}"
                                          Command="{Binding SelectAllCommand}"
                                          ToolTip="{Binding [DeepClean_SelectAll], Source={x:Static services:LanguageManager.Instance}}"
                                          Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>

            <WrapPanel Margin="0,10,0,0">
                <controls:ZButton Content="{Binding [Apps_FilterAll], Source={x:Static services:LanguageManager.Instance}}"
                                  Variant="Ghost" Margin="0,0,6,6"
                                  Command="{Binding SetFilterCategoryCommand}" CommandParameter="All"/>
                <controls:ZButton Content="{Binding [Apps_Filter64Bit], Source={x:Static services:LanguageManager.Instance}}"
                                  Variant="Ghost" Margin="0,0,6,6"
                                  Command="{Binding SetFilterCategoryCommand}" CommandParameter="64Bit"/>
                <controls:ZButton Content="{Binding [Apps_Filter32Bit], Source={x:Static services:LanguageManager.Instance}}"
                                  Variant="Ghost" Margin="0,0,6,6"
                                  Command="{Binding SetFilterCategoryCommand}" CommandParameter="32Bit"/>
                <controls:ZButton Content="{Binding [Apps_FilterLarge], Source={x:Static services:LanguageManager.Instance}}"
                                  Variant="Ghost" Margin="0,0,6,6"
                                  Command="{Binding SetFilterCategoryCommand}" CommandParameter="Large"/>
                <controls:ZButton Content="{Binding [Apps_FilterRecent], Source={x:Static services:LanguageManager.Instance}}"
                                  Variant="Ghost" Margin="0,0,6,6"
                                  Command="{Binding SetFilterCategoryCommand}" CommandParameter="Recent"/>
                <controls:ZButton Content="{Binding [Apps_FilterBroken], Source={x:Static services:LanguageManager.Instance}}"
                                  Variant="Ghost" Margin="0,0,0,6"
                                  Command="{Binding SetFilterCategoryCommand}" CommandParameter="Broken"/>
            </WrapPanel>
        </StackPanel>

        <!-- Multi-selection bar uses a second row for actions so localization cannot overlap the count. -->
        <Border Grid.Row="1"
                Background="{StaticResource ZBrushAccentTint}"
                BorderBrush="#36EA0232"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,10"
                Margin="0,0,0,12"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SelectedCountText}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource ZBrushAccent}"
                               TextTrimming="CharacterEllipsis"/>
                    <controls:ZIconButton Grid.Column="1"
                                          Icon="{StaticResource StrokeIconClose}"
                                          Command="{Binding ClearSelectionCommand}"
                                          ToolTip="{Binding [Apps_CloseActionBar], Source={x:Static services:LanguageManager.Instance}}"/>
                </Grid>

                <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                    <controls:ZButton Content="{Binding [Apps_QuietUninstall], Source={x:Static services:LanguageManager.Instance}}"
                                      Variant="Secondary"
                                      Command="{Binding QuietUninstallCommand}"
                                      Margin="0,0,8,0"/>
                    <controls:ZButton Content="{Binding [Apps_Uninstall], Source={x:Static services:LanguageManager.Instance}}"
                                      Icon="{StaticResource StrokeIconTrash}"
                                      Command="{Binding UninstallCommand}"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <ListBox ItemsSource="{Binding ItemsView}"
                     SelectedItem="{Binding SelectedApp}"
                     ItemContainerStyle="{StaticResource ZAppsListItemStyle}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <controls:ZAppCard Icon="{Binding Icon}"
                                           Title="{Binding DisplayName}"
                                           Subtitle="{Binding Summary}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <controls:ZBadge Content="{Binding [Apps_BrokenBadge], Source={x:Static services:LanguageManager.Instance}}"
                                                 Variant="Danger"
                                                 Margin="0,0,8,0"
                                                 Visibility="{Binding IsBroken, Converter={StaticResource BoolToVis}}"/>
                                <controls:ZBadge Content="{Binding [Apps_Processing], Source={x:Static services:LanguageManager.Instance}}"
                                                 Variant="Accent"
                                                 Margin="0,0,8,0"
                                                 Visibility="{Binding IsUninstalling, Converter={StaticResource BoolToVis}}"/>
                                <controls:ZBadge Content="{Binding KindText}"
                                                 Variant="{Binding Kind, Converter={StaticResource KindToBadge}}"/>
                                <controls:ZIconButton Icon="{StaticResource StrokeIconInfo}"
                                                      Margin="8,0,0,0"
                                                      ToolTip="{Binding [Apps_Details], Source={x:Static services:LanguageManager.Instance}}"
                                                      Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                <controls:ZCheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                    ToolTip="{Binding [Apps_SelectedCount], Source={x:Static services:LanguageManager.Instance}}"
                                                    Margin="10,0,0,0"/>
                            </StackPanel>
                        </controls:ZAppCard>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Selected-app actions: info on top, actions wrap below. -->
            <Border VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch"
                    Margin="8,0,8,8"
                    Background="{StaticResource ZBrushSurface}"
                    CornerRadius="12"
                    BorderBrush="{StaticResource ZBrushBorderStrong}"
                    BorderThickness="1"
                    Padding="12"
                    Visibility="{Binding SelectedApp, Converter={StaticResource NotNullToVis}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.10" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="8"
                                    Background="{StaticResource ZBrushSurfaceMuted}"
                                    BorderBrush="{StaticResource ZBrushBorder}"
                                    BorderThickness="1">
                                <Image Source="{Binding SelectedApp.Icon}" Width="23" Height="23" Stretch="Uniform"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedApp.DisplayName}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="{StaticResource ZBrushBlack}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SelectedApp.Summary}"
                                           FontSize="11.5"
                                           Foreground="{StaticResource ZBrushGray}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </StackPanel>
                        <controls:ZIconButton Grid.Column="1"
                                              Icon="{StaticResource StrokeIconClose}"
                                              Command="{Binding ClearSelectionCommand}"
                                              ToolTip="{Binding [Apps_CloseActionBar], Source={x:Static services:LanguageManager.Instance}}"/>
                    </Grid>

                    <WrapPanel Grid.Row="1" Margin="0,10,0,0">
                        <controls:ZButton Content="{Binding [Apps_Uninstall], Source={x:Static services:LanguageManager.Instance}}"
                                          Icon="{StaticResource StrokeIconTrash}"
                                          Command="{Binding UninstallCommand}"
                                          Margin="0,0,8,6"/>
                        <controls:ZButton Content="{Binding [Apps_QuietUninstall], Source={x:Static services:LanguageManager.Instance}}"
                                          Variant="Secondary"
                                          Command="{Binding QuietUninstallCommand}"
                                          Margin="0,0,8,6"/>
                        <controls:ZButton Content="{Binding [Apps_DeepClean], Source={x:Static services:LanguageManager.Instance}}"
                                          Variant="Secondary"
                                          Icon="{StaticResource StrokeIconRescan}"
                                          Command="{Binding DeepCleanSelectedCommand}"
                                          Margin="0,0,8,6"/>
                        <controls:ZButton Content="{Binding [Apps_Details], Source={x:Static services:LanguageManager.Instance}}"
                                          Variant="Ghost"
                                          Icon="{StaticResource StrokeIconInfo}"
                                          Command="{Binding OpenDetailsCommand}"
                                          CommandParameter="{Binding SelectedApp}"
                                          Margin="0,0,0,6"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <controls:ZEmptyState Icon="{StaticResource StrokeIconApps}"
                                  Title="{Binding [Apps_EmptyTitle], Source={x:Static services:LanguageManager.Instance}}"
                                  Subtitle="{Binding [Apps_EmptySubtitle], Source={x:Static services:LanguageManager.Instance}}"
                                  Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}"/>
            <controls:ZEmptyState Icon="{StaticResource StrokeIconSearch}"
                                  Title="{Binding [Apps_NoResultsTitle], Source={x:Static services:LanguageManager.Instance}}"
                                  Subtitle="{Binding [Apps_NoResultsSubtitle], Source={x:Static services:LanguageManager.Instance}}"
                                  Visibility="{Binding ShowNoResults, Converter={StaticResource BoolToVis}}"/>

            <Border Background="{StaticResource ZBrushBackground}"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                    Panel.ZIndex="10">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <controls:ZProgressRing RingSize="40" IsActive="{Binding IsLoading}"/>
                    <TextBlock Text="{Binding [Apps_Scanning], Source={x:Static services:LanguageManager.Instance}}"
                               Margin="0,14,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource ZBrushGray}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                BorderBrush="{StaticResource ZBrushBorder}"
                BorderThickness="0,1,0,0"
                Margin="0,10,0,0"
                Padding="4,9,4,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}"
                           Margin="0,0,12,0"
                           FontSize="12"
                           Foreground="{StaticResource ZBrushGray}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1"
                           FontSize="12"
                           Foreground="{StaticResource ZBrushGray}"
                           VerticalAlignment="Center">
                    <Run Text="{Binding VisibleCount, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding TotalCount, Mode=OneWay}"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
