<UserControl x:Class="zidimi_uninstaller.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:zidimi_uninstaller.Controls"
             xmlns:services="clr-namespace:zidimi_uninstaller.Services"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Statistics cards -->
        <StackPanel Grid.Row="0">
            <UniformGrid Columns="4">
                <controls:ZStatCard Margin="0,0,12,0"
                                    Icon="{StaticResource IconApps}"
                                    IconBrush="{StaticResource ZBrushAccent}"
                                    Value="{Binding AppCount}"
                                    Label="{Binding [Dashboard_AppCount], Source={x:Static services:LanguageManager.Instance}}"/>
                <controls:ZStatCard Margin="0,0,12,0"
                                    Icon="{StaticResource IconStore}"
                                    IconBrush="{StaticResource ZBrushBrown}"
                                    Value="{Binding StoreAppCount}"
                                    Label="{Binding [Dashboard_StoreAppCount], Source={x:Static services:LanguageManager.Instance}}"/>
                <controls:ZStatCard Margin="0,0,12,0"
                                    Icon="{StaticResource IconStartup}"
                                    IconBrush="{StaticResource ZBrushAccentLight}"
                                    Value="{Binding StartupCount}"
                                    Label="{Binding [Dashboard_StartupCount], Source={x:Static services:LanguageManager.Instance}}"/>
                <controls:ZStatCard Icon="{StaticResource IconMemory}"
                                    IconBrush="{StaticResource ZBrushDarkGray}"
                                    Value="{Binding TotalSizeText}"
                                    Label="{Binding [Dashboard_TotalSize], Source={x:Static services:LanguageManager.Instance}}"/>
            </UniformGrid>

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <controls:ZButton Content="{Binding [Dashboard_Rescan], Source={x:Static services:LanguageManager.Instance}}"
                                  Icon="{StaticResource IconRefresh}"
                                  Command="{Binding RefreshCommand}"/>
                <controls:ZButton Content="{Binding [Dashboard_ReloadAll], Source={x:Static services:LanguageManager.Instance}}"
                                  Variant="Secondary"
                                  Icon="{StaticResource IconRestart}"
                                  Margin="10,0,0,0"
                                  Command="{Binding ReloadAllCommand}"/>
            </StackPanel>
        </StackPanel>

        <!-- Recently installed -->
        <controls:ZCard Grid.Row="1" Margin="0,24,0,0" Padding="20,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <controls:ZSectionHeader Title="{Binding [Dashboard_RecentInstalled], Source={x:Static services:LanguageManager.Instance}}"
                                         Subtitle="{Binding [Dashboard_RecentSubtitle], Source={x:Static services:LanguageManager.Instance}}"
                                         Icon="{StaticResource IconClock}">
                    <controls:ZBadge Content="{Binding RecentlyInstalled.Count, StringFormat={}{0} apps}" Variant="Accent"
                                     HorizontalAlignment="Right"/>
                </controls:ZSectionHeader>

                <ListBox Grid.Row="1" ItemsSource="{Binding RecentlyInstalled}"
                         ItemContainerStyle="{StaticResource ZAppsListItemStyle}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Background="Transparent"
                         Margin="0,12,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <controls:ZAppCard Icon="{Binding Icon}"
                                               Title="{Binding DisplayName}"
                                               Subtitle="{Binding Summary}">
                                <controls:ZBadge Content="{Binding KindText}"
                                                 Variant="{Binding Kind, Converter={StaticResource KindToBadge}}"
                                                 VerticalAlignment="Center"/>
                            </controls:ZAppCard>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="1" Background="#CCF2F2F2"
                      Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Panel.ZIndex="10">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <controls:ZProgressRing RingSize="40"/>
                        <TextBlock Text="{Binding [Dashboard_Scanning], Source={x:Static services:LanguageManager.Instance}}" Margin="0,14,0,0" HorizontalAlignment="Center"
                                   Foreground="{StaticResource ZBrushGray}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </controls:ZCard>
    </Grid>
</UserControl>