<UserControl x:Class="zidimi_uninstaller.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:zidimi_uninstaller.Controls"
             xmlns:services="clr-namespace:zidimi_uninstaller.Services"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 2x2 keeps the cards readable even at the minimum window width. -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <controls:ZStatCard Grid.Row="0" Grid.Column="0" Margin="4"
                                Icon="{StaticResource StrokeIconApps}"
                                IconBrush="{StaticResource ZBrushAccent}"
                                Value="{Binding AppCount}"
                                Label="{Binding [Dashboard_AppCount], Source={x:Static services:LanguageManager.Instance}}"/>
            <controls:ZStatCard Grid.Row="0" Grid.Column="1" Margin="4"
                                Icon="{StaticResource StrokeIconStore}"
                                IconBrush="{StaticResource ZBrushBrown}"
                                Value="{Binding StoreAppCount}"
                                Label="{Binding [Dashboard_StoreAppCount], Source={x:Static services:LanguageManager.Instance}}"/>
            <controls:ZStatCard Grid.Row="0" Grid.Column="2" Margin="4"
                                Icon="{StaticResource StrokeIconStartup}"
                                IconBrush="{StaticResource ZBrushAccentLight}"
                                Value="{Binding StartupCount}"
                                Label="{Binding [Dashboard_StartupCount], Source={x:Static services:LanguageManager.Instance}}"/>
            <controls:ZStatCard Grid.Row="0" Grid.Column="3" Margin="4"
                                Icon="{StaticResource StrokeIconMemory}"
                                IconBrush="{StaticResource ZBrushDarkGray}"
                                Value="{Binding TotalSizeText}"
                                Label="{Binding [Dashboard_TotalSize], Source={x:Static services:LanguageManager.Instance}}"/>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,12,0,0"
                Padding="12"
                Background="{StaticResource ZBrushSurfaceMuted}"
                BorderBrush="{StaticResource ZBrushBorder}"
                BorderThickness="1"
                CornerRadius="10">
            <WrapPanel Orientation="Horizontal">
                <controls:ZButton Content="{Binding [Dashboard_Rescan], Source={x:Static services:LanguageManager.Instance}}"
                                  Icon="{StaticResource StrokeIconRescan}"
                                  Command="{Binding RescanCommand}"
                                  Margin="0,0,8,0"/>
                <controls:ZButton Content="{Binding [Dashboard_ReloadAll], Source={x:Static services:LanguageManager.Instance}}"
                                  Variant="Secondary"
                                  Icon="{StaticResource StrokeIconReloadAll}"
                                  Command="{Binding ReloadAllCommand}"/>
            </WrapPanel>
        </Border>

        <controls:ZCard Grid.Row="2" Margin="0,12,0,0" Padding="15,13">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <controls:ZSectionHeader Title="{Binding [Dashboard_RecentInstalled], Source={x:Static services:LanguageManager.Instance}}"
                                         Subtitle="{Binding [Dashboard_RecentSubtitle], Source={x:Static services:LanguageManager.Instance}}"
                                         Icon="{StaticResource StrokeIconClock}">
                    <controls:ZBadge Content="{Binding RecentlyInstalled.Count}"
                                     Variant="Accent" HorizontalAlignment="Right"/>
                </controls:ZSectionHeader>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding RecentlyInstalled}"
                         ItemContainerStyle="{StaticResource ZAppsListItemStyle}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Background="Transparent"
                         Margin="0,8,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <controls:ZAppCard Icon="{Binding Icon}"
                                               Title="{Binding DisplayName}"
                                               Subtitle="{Binding Summary}">
                                <controls:ZBadge Content="{Binding KindText}"
                                                 Variant="{Binding Kind, Converter={StaticResource KindToBadge}}"
                                                 VerticalAlignment="Center"/>
                            </controls:ZAppCard>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="1"
                        Background="{StaticResource ZBrushSurface}"
                        CornerRadius="10"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                        Panel.ZIndex="10">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <controls:ZProgressRing RingSize="34" IsActive="{Binding IsLoading}"/>
                        <TextBlock Text="{Binding [Dashboard_Scanning], Source={x:Static services:LanguageManager.Instance}}"
                                   Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource ZBrushGray}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </controls:ZCard>
    </Grid>
</UserControl>
