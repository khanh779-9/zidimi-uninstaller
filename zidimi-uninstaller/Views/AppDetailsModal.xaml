<UserControl x:Class="zidimi_uninstaller.Views.AppDetailsModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:zidimi_uninstaller.Controls"
             xmlns:services="clr-namespace:zidimi_uninstaller.Services"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Border Background="{StaticResource ZBrushWhite}" CornerRadius="16"
            BorderBrush="{StaticResource ZBrushLightGray}" BorderThickness="1"
            Padding="26" Width="720" MaxWidth="760"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border.Effect>
            <DropShadowEffect BlurRadius="36" ShadowDepth="10" Opacity="0.28" Color="#000000"/>
        </Border.Effect>

        <StackPanel>
            <!-- Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="52" Height="52" CornerRadius="13" Background="{StaticResource ZBrushCard}" VerticalAlignment="Center">
                    <Image Source="{Binding SelectedApp.Icon}" Width="36" Height="36" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedApp.DisplayName}" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource ZBrushBlack}" TextTrimming="CharacterEllipsis"/>
                    <WrapPanel Margin="0,6,0,0">
                        <controls:ZBadge Content="{Binding SelectedApp.KindText}"
                                         Variant="{Binding SelectedApp.Kind, Converter={StaticResource KindToBadge}}"/>
                        <controls:ZBadge Content="{Binding SelectedApp.RegistryHive}" Variant="Info" Margin="6,0,0,0"/>
                        <controls:ZBadge Content="{Binding SelectedApp.ArchitectureText}" Variant="Neutral" Margin="6,0,0,0"/>
                        <controls:ZBadge Content="{Binding [Apps_SystemComponentBadge], Source={x:Static services:LanguageManager.Instance}}"
                                         Variant="Danger" Margin="6,0,0,0"
                                         Visibility="{Binding SelectedApp.IsSystemComponent, Converter={StaticResource BoolToVis}}"/>
                        <controls:ZBadge Content="{Binding [Apps_BrokenBadge], Source={x:Static services:LanguageManager.Instance}}"
                                         Variant="Danger" Margin="6,0,0,0"
                                         Visibility="{Binding SelectedApp.IsBroken, Converter={StaticResource BoolToVis}}"/>
                    </WrapPanel>
                </StackPanel>

                <controls:ZIconButton Grid.Column="2" Icon="{StaticResource IconClose}"
                                      Command="{Binding CloseDetailsCommand}"
                                      ToolTip="{Binding [Apps_CloseTooltip], Source={x:Static services:LanguageManager.Instance}}"/>
            </Grid>

            <Separator Height="1" Background="{StaticResource ZBrushLightGray}" Margin="0,0,0,16"/>

            <!-- Details Grid -->
            <Grid Margin="4,0,4,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.4*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <controls:ZInfoRow Label="{Binding [Apps_PublisherLabel], Source={x:Static services:LanguageManager.Instance}}" Value="{Binding SelectedApp.Publisher}"/>
                    <controls:ZInfoRow Label="{Binding [Apps_VersionLabel], Source={x:Static services:LanguageManager.Instance}}" Value="{Binding SelectedApp.DisplayVersion}"/>
                    <controls:ZInfoRow Label="{Binding [Apps_SizeLabel], Source={x:Static services:LanguageManager.Instance}}" Value="{Binding SelectedApp.SizeText}"/>
                    <controls:ZInfoRow Label="{Binding [Apps_InstallDateLabel], Source={x:Static services:LanguageManager.Instance}}" Value="{Binding SelectedApp.InstallDateText}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <controls:ZInfoRow Label="{Binding [Apps_InstallLocationLabel], Source={x:Static services:LanguageManager.Instance}}" Value="{Binding SelectedApp.InstallLocation}"/>
                    <controls:ZInfoRow Label="{Binding [Apps_InstallSourceLabel], Source={x:Static services:LanguageManager.Instance}}" Value="{Binding SelectedApp.InstallSource}"/>
                    <controls:ZInfoRow Label="{Binding [Apps_WebsiteLabel], Source={x:Static services:LanguageManager.Instance}}" Value="{Binding SelectedApp.AboutUrl}"/>
                    <controls:ZInfoRow Label="{Binding [Apps_RegistryKeyLabel], Source={x:Static services:LanguageManager.Instance}}" Value="{Binding SelectedApp.RegistryKeyName}"/>
                </StackPanel>
            </Grid>

            <Separator Height="1" Background="{StaticResource ZBrushLightGray}" Margin="0,0,0,16"/>

            <!-- Single Unified WrapPanel for all action buttons -->
            <WrapPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <controls:ZButton Content="{Binding [Apps_Uninstall], Source={x:Static services:LanguageManager.Instance}}"
                                  Variant="Primary" Icon="{StaticResource IconTrash}"
                                  Command="{Binding UninstallCommand}" Margin="0,0,8,8"/>
                <controls:ZButton Content="{Binding [Apps_QuietUninstall], Source={x:Static services:LanguageManager.Instance}}"
                                  Variant="Secondary"
                                  Command="{Binding QuietUninstallCommand}" Margin="0,0,8,8"/>
                <controls:ZButton Content="{Binding [Apps_DeepClean], Source={x:Static services:LanguageManager.Instance}}"
                                  Variant="Secondary" Icon="{StaticResource IconSearch}"
                                  Command="{Binding DeepCleanSelectedCommand}" Margin="0,0,8,8"/>
                <controls:ZButton Content="{Binding [Apps_Modify], Source={x:Static services:LanguageManager.Instance}}"
                                  Variant="Secondary"
                                  Command="{Binding ModifyCommand}" Margin="0,0,8,8"/>
                <controls:ZButton Content="{Binding [Apps_OpenFolder], Source={x:Static services:LanguageManager.Instance}}"
                                  Variant="Ghost" Icon="{StaticResource IconFolder}"
                                  Command="{Binding OpenLocationCommand}" Margin="0,0,8,8"/>
                <controls:ZButton Content="{Binding [Apps_OpenWebsite], Source={x:Static services:LanguageManager.Instance}}"
                                  Variant="Ghost" Icon="{StaticResource IconGlobe}"
                                  Command="{Binding OpenUrlCommand}" Margin="0,0,8,8"/>
                <controls:ZButton Content="{Binding [Apps_DeleteRegistry], Source={x:Static services:LanguageManager.Instance}}"
                                  Variant="Danger" Icon="{StaticResource IconError}"
                                  Command="{Binding ForceRemoveCommand}" Margin="0,0,8,8"/>
                <controls:ZButton Content="{Binding [Apps_Close], Source={x:Static services:LanguageManager.Instance}}" Variant="Secondary"
                                  Command="{Binding CloseDetailsCommand}" Margin="0,0,0,8"/>
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
