<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:zidimi_uninstaller.Controls"
>

    <!-- ============ ZToggleRow ============ -->
    <Style TargetType="{x:Type controls:ZToggleRow}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ZToggleRow}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Title}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource ZBrushBlack}"/>
                            <TextBlock Text="{TemplateBinding Subtitle}" FontSize="12" Foreground="{StaticResource ZBrushGray}"
                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                        <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}"
                                          VerticalAlignment="Center" Margin="14,0,0,0"/>
                        <controls:ZToggleButton Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center"
                                                IsChecked="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsOn, Mode=TwoWay}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

