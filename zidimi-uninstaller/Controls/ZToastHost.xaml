<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:zidimi_uninstaller.Controls"
>

    <!-- ============ ZToastHost ============ -->
    <Style TargetType="{x:Type controls:ZToastHost}">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ZToastHost}">
                    <ItemsControl ItemsSource="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ToastItems}"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,18">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ToastCard" Background="{StaticResource ZBrushWhite}" CornerRadius="12"
                                        BorderBrush="{StaticResource ZBrushLightGray}" BorderThickness="1"
                                        Margin="0,6" Padding="14,12" MinWidth="300" MaxWidth="400" HorizontalAlignment="Right">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.14" Color="#121012"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="AccentBar" Width="3" CornerRadius="1.5"
                                                Background="{StaticResource ZBrushAccent}" VerticalAlignment="Stretch"/>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{StaticResource ZBrushBlack}"/>
                                            <TextBlock Text="{Binding Message}" FontSize="12" Foreground="{StaticResource ZBrushGray}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Type}" Value="Success">
                                        <Setter TargetName="AccentBar" Property="Background" Value="#1E7A3C"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type}" Value="Warning">
                                        <Setter TargetName="AccentBar" Property="Background" Value="#9A6700"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Type}" Value="Error">
                                        <Setter TargetName="AccentBar" Property="Background" Value="{StaticResource ZBrushBrown}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsClosing}" Value="True">
                                        <Setter TargetName="ToastCard" Property="Opacity" Value="0"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

