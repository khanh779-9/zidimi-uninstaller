<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:zidimi_uninstaller.Controls">
    <Style TargetType="{x:Type controls:ZSectionHeader}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ZSectionHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border x:Name="IconWrap" Width="32" Height="32" CornerRadius="8" Background="{StaticResource ZBrushAccentTint}" BorderBrush="#28EA0232" BorderThickness="1">
                            <Path Data="{TemplateBinding Icon}" Width="15" Height="15" Fill="Transparent" Stroke="{StaticResource ZBrushAccent}" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Title}" FontSize="14.5" FontWeight="SemiBold" Foreground="{StaticResource ZBrushBlack}"/>
                            <TextBlock Text="{TemplateBinding Subtitle}" FontSize="11.8" Foreground="{StaticResource ZBrushGray}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ContentPresenter Grid.Column="2" Content="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers><Trigger Property="Icon" Value="{x:Null}"><Setter TargetName="IconWrap" Property="Visibility" Value="Collapsed"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
