<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:zidimi_uninstaller.Controls"
>
    <Style TargetType="{x:Type controls:ZSectionHeader}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ZSectionHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="IconWrap" Width="36" Height="36" CornerRadius="10" Background="{StaticResource ZBrushAccentTint}">
                            <Path Data="{TemplateBinding Icon}" Width="17" Height="17" Fill="{StaticResource ZBrushAccent}"
                                  Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{TemplateBinding Title}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource ZBrushBlack}"/>
                            <TextBlock Text="{TemplateBinding Subtitle}" FontSize="12" Foreground="{StaticResource ZBrushGray}"
                                       Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ContentPresenter Grid.Column="2" Content="{TemplateBinding Content}"
                                          VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconWrap" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

