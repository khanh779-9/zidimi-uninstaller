<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:zidimi_uninstaller.Controls">
    <Style TargetType="{x:Type controls:ZStatCard}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ZStatCard}">
                    <Border Background="{StaticResource ZBrushSurface}"
                            BorderBrush="{StaticResource ZBrushBorder}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="15">
                        <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.03" Color="#121012"/></Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="IconWrap" Width="38" Height="38" CornerRadius="9"
                                    Background="{StaticResource ZBrushSurfaceMuted}"
                                    BorderBrush="{StaticResource ZBrushBorder}" BorderThickness="1">
                                <Path Data="{TemplateBinding Icon}"
                                      Fill="Transparent"
                                      Stroke="{TemplateBinding IconBrush}"
                                      StrokeThickness="1.8"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Stretch="Uniform" Width="18" Height="18"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Value}" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource ZBrushBlack}"/>
                                <TextBlock Text="{TemplateBinding Label}" FontSize="11.8" Foreground="{StaticResource ZBrushGray}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers><Trigger Property="Icon" Value="{x:Null}"><Setter TargetName="IconWrap" Property="Visibility" Value="Collapsed"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
