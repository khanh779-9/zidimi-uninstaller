<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:zidimi_uninstaller.Controls"
>

    <!-- ============ ZStatCard ============ -->
    <Style TargetType="{x:Type controls:ZStatCard}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ZStatCard}">
                    <Border Background="{StaticResource ZBrushWhite}" BorderBrush="{StaticResource ZBrushLightGray}"
                            BorderThickness="1" CornerRadius="14" Padding="18">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.05" Color="#121012"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="IconWrap" Width="44" Height="44" CornerRadius="12" Background="{TemplateBinding IconBrush}">
                                <Path Data="{TemplateBinding Icon}" Fill="White" Stretch="Uniform" Width="22" Height="22"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Value}" FontSize="26" FontWeight="Bold"
                                           Foreground="{StaticResource ZBrushBlack}"/>
                                <TextBlock Text="{TemplateBinding Label}" FontSize="12.5" Foreground="{StaticResource ZBrushGray}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconWrap" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

