<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:zidimi_uninstaller.Controls"
>
    <Style TargetType="{x:Type controls:ZAppCard}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ZAppCard}">
                    <Border Background="Transparent" CornerRadius="10" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="IconWrap" Width="44" Height="44" CornerRadius="10" Background="{StaticResource ZBrushSurfaceMuted}" BorderBrush="{StaticResource ZBrushBorder}" BorderThickness="1">
                                <Image x:Name="IconImage" Source="{TemplateBinding Icon}" Width="28" Height="28" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Title}" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource ZBrushBlack}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{TemplateBinding Subtitle}" FontSize="12" Foreground="{StaticResource ZBrushGray}"
                                           TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                            </StackPanel>
                            <ContentPresenter Grid.Column="2" Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconWrap" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

