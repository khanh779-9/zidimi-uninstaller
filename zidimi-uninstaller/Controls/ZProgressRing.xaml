<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:zidimi_uninstaller.Controls">
    <Style TargetType="{x:Type controls:ZProgressRing}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ZProgressRing}">
                    <Grid x:Name="RingRoot"
                          Width="{TemplateBinding RingSize}"
                          Height="{TemplateBinding RingSize}"
                          SnapsToDevicePixels="True">
                        <Ellipse Margin="2.5"
                                 Stroke="#26EA0232"
                                 StrokeThickness="2.5"/>

                        <Viewbox x:Name="PART_Indicator"
                                 Margin="2.5"
                                 Stretch="Uniform"
                                 RenderTransformOrigin="0.5,0.5">
                            <Canvas Width="24" Height="24">
                                <Path Data="M12,3 A9,9 0 0 1 21,12 A9,9 0 0 1 12,21"
                                      Fill="Transparent"
                                      Stroke="{StaticResource ZBrushAccent}"
                                      StrokeThickness="2.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
