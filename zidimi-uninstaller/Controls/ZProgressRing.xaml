<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:zidimi_uninstaller.Controls"
>
    <Style TargetType="{x:Type controls:ZProgressRing}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ZProgressRing}">
                    <Grid x:Name="RingRoot" Width="{TemplateBinding RingSize}" Height="{TemplateBinding RingSize}">
                        <Ellipse Stroke="#14EA0232" StrokeThickness="3"/>
                        <Path Stroke="{StaticResource ZBrushAccent}" StrokeThickness="3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 4,20 A 16,16 0 0 1 20,4" Stretch="None"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

