<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:zidimi_uninstaller.Controls"
>

    <!-- ============ ZEmptyState ============ -->
    <Style TargetType="{x:Type controls:ZEmptyState}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ZEmptyState}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
                        <Border x:Name="IconWrap" Width="88" Height="88" CornerRadius="44" Background="{StaticResource ZBrushCard}" HorizontalAlignment="Center">
                            <Path Data="{TemplateBinding Icon}" Width="38" Height="38" Fill="{StaticResource ZBrushMidGray}"
                                  Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{TemplateBinding Title}" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource ZBrushBlack}" TextAlignment="Center" Margin="0,18,0,0"/>
                        <TextBlock Text="{TemplateBinding Subtitle}" FontSize="13" Foreground="{StaticResource ZBrushGray}"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" Margin="0,22,0,0"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconWrap" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

