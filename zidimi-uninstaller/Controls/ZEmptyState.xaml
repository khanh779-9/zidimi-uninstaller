<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:zidimi_uninstaller.Controls">
    <Style TargetType="{x:Type controls:ZEmptyState}">
        <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/><Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="{x:Type controls:ZEmptyState}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="36" MaxWidth="480">
                    <Border x:Name="IconWrap" Width="72" Height="72" CornerRadius="36" Background="{StaticResource ZBrushSurfaceMuted}" BorderBrush="{StaticResource ZBrushBorder}" BorderThickness="1" HorizontalAlignment="Center">
                        <Path Data="{TemplateBinding Icon}" Width="30" Height="30" Fill="Transparent" Stroke="{StaticResource ZBrushMidGray}" StrokeThickness="1.75" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{TemplateBinding Title}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource ZBrushBlack}" TextAlignment="Center" Margin="0,18,0,0"/>
                    <TextBlock Text="{TemplateBinding Subtitle}" FontSize="13" Foreground="{StaticResource ZBrushGray}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                </StackPanel>
                <ControlTemplate.Triggers><Trigger Property="Icon" Value="{x:Null}"><Setter TargetName="IconWrap" Property="Visibility" Value="Collapsed"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate>
        </Setter.Value></Setter>
    </Style>
</ResourceDictionary>
