<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:zidimi_uninstaller.Controls"
>
    <Style TargetType="{x:Type controls:ZSearchBox}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource ZBrushBlack}"/>
        <Setter Property="CaretBrush" Value="{StaticResource ZBrushAccent}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource ZBrushAccent}"/>
        <Setter Property="Background" Value="{StaticResource ZBrushWhite}"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ZSearchBox}">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource ZBrushLightGray}"
                            BorderThickness="1" CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource IconSearch}" Width="15" Height="15" Fill="{StaticResource ZBrushGray}"
                                  Margin="12,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PART_Placeholder" Grid.Column="1" Text="{TemplateBinding Placeholder}"
                                       Foreground="{StaticResource ZBrushGray}" FontSize="13" Margin="9,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"/>
                            <Button x:Name="PART_Clear" Grid.Column="2" Width="24" Height="24" Margin="6,0,8,0" Cursor="Hand"
                                    Background="Transparent" BorderThickness="0" Focusable="False" Visibility="Collapsed">
                                <Path Data="{StaticResource IconClose}" Width="10" Height="10" Fill="{StaticResource ZBrushGray}"/>
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ZBrushMidGray}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ZBrushAccent}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

