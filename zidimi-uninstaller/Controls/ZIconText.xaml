<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:zidimi_uninstaller.Controls"
>

    <!-- ============ ZIconText ============ -->
    <Style TargetType="{x:Type controls:ZIconText}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ZIconText}">
                    <StackPanel Orientation="Horizontal">
                        <Path x:Name="IconPath" Data="{TemplateBinding Icon}" Width="{TemplateBinding IconSize}"
                              Height="{TemplateBinding IconSize}" Fill="{StaticResource ZBrushGray}" Stretch="Uniform"
                              VerticalAlignment="Center"/>
                        <TextBlock Text="{TemplateBinding Text}" FontSize="12" Foreground="{StaticResource ZBrushGray}"
                                   Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconPath" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

