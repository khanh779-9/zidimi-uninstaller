<controls:ZWindow x:Class="zidimi_uninstaller.MainWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:controls="clr-namespace:zidimi_uninstaller.Controls"
               xmlns:views="clr-namespace:zidimi_uninstaller.Views"
               xmlns:vm="clr-namespace:zidimi_uninstaller.ViewModels"
               mc:Ignorable="d"
               WindowStyle="SingleBorderWindow"
               Title="Zidimi Uninstaller" Height="760" Width="1180"
               MinHeight="600" MinWidth="920"
               Background="{StaticResource ZBrushWhite}"
               WindowStartupLocation="CenterScreen"
               Icon="pack://application:,,,/zidimi-icon.ico"
               
               UseLayoutRounding="True"
               SnapsToDevicePixels="True"
               TextOptions.TextFormattingMode="Display"
               TextOptions.TextRenderingMode="ClearType"
               TextOptions.TextHintingMode="Fixed">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <views:SidebarView Grid.Column="0"/>

        <!-- Main content area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="24,18,24,16"
                    BorderBrush="{StaticResource ZBrushLightGray}"
                    BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ZBrushBlack}"/>
                    <TextBlock Text="{Binding PageSubtitle}"
                               Margin="0,4,0,0"
                               FontSize="13"
                               Foreground="{StaticResource ZBrushGray}"/>
                </StackPanel>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Focusable="False">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                        <views:DashboardView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:ApplicationsViewModel}">
                        <views:ApplicationsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:StoreAppsViewModel}">
                        <views:StoreAppsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:StartupViewModel}">
                        <views:StartupView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:PackagesViewModel}">
                        <views:PackagesView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:WindowsFeaturesViewModel}">
                        <views:WindowsFeaturesView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                        <views:SettingsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:LeftoversViewModel}">
                        <views:LeftoversView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
                        <views:HistoryView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:InstallMonitorViewModel}">
                        <views:InstallMonitorView/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>

        <!-- Confirmation dialog -->
        <controls:ZDialog Grid.Column="0" Grid.ColumnSpan="2" x:Name="ConfirmDialog"
                          Panel.ZIndex="100"/>

        <!-- About Modal Overlay -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2" Background="#7F000000"
              Visibility="{Binding IsAboutModalOpen, Converter={StaticResource BoolToVis}}"
              PreviewMouseDown="OnModalBackdropMouseDown"
              Panel.ZIndex="110">
            <views:AboutModal DataContext="{Binding}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="24"/>
        </Grid>

        <!-- Application Details Modal Overlay -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2" Background="#7F000000"
              Visibility="{Binding Applications.IsDetailsModalOpen, Converter={StaticResource BoolToVis}}"
              PreviewMouseDown="OnModalBackdropMouseDown"
              Panel.ZIndex="105">
            <views:AppDetailsModal DataContext="{Binding Applications}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="24"/>
        </Grid>

        <!-- Startup Details Modal Overlay -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2" Background="#7F000000"
              Visibility="{Binding Startup.IsDetailsModalOpen, Converter={StaticResource BoolToVis}}"
              PreviewMouseDown="OnModalBackdropMouseDown"
              Panel.ZIndex="106">
            <views:StartupDetailsModal DataContext="{Binding Startup}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="24"/>
        </Grid>

        <!-- Deep Clean Modal Overlay -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2" Background="#7F000000"
              Visibility="{Binding DeepClean.IsOpen, Converter={StaticResource BoolToVis}}"
              PreviewMouseDown="OnModalBackdropMouseDown"
              Panel.ZIndex="95">
            <views:DeepCleanView DataContext="{Binding DeepClean}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Margin="24"/>
        </Grid>

        <!-- Toast notifications -->
        <controls:ZToastHost Grid.Column="1" x:Name="ToastHost"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,78,18,0" Panel.ZIndex="90"/>
    </Grid>
</controls:ZWindow>