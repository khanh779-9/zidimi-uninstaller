<controls:ZWindow x:Class="zidimi_uninstaller.MainWindow"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:local="clr-namespace:zidimi_uninstaller"
               xmlns:controls="clr-namespace:zidimi_uninstaller.Controls"
               xmlns:views="clr-namespace:zidimi_uninstaller.Views"
               xmlns:vm="clr-namespace:zidimi_uninstaller.ViewModels"
               xmlns:services="clr-namespace:zidimi_uninstaller.Services"
               mc:Ignorable="d"
               WindowStyle="SingleBorderWindow"
               Title="Zidimi Uninstaller" Height="760" Width="1180"
               MinHeight="600" MinWidth="920"
               Background="{StaticResource ZBrushWhite}"
               WindowStartupLocation="CenterScreen"
               Icon="pack://application:,,,/zidimi-icon.ico"
               Style="{StaticResource ZWindowStyle}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Left sidebar ============ -->
        <Grid Grid.Column="0" Width="236">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="{StaticResource ZBrushDark}" CornerRadius="0,18,0,0">
                <Grid Margin="16,24,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,0,0,24">
                        <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource ZBrushAccent}">
                            <Path Data="{StaticResource IconApps}" Fill="{StaticResource ZBrushWhite}"
                                  Stretch="Uniform" Margin="8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Zidimi" FontSize="17" FontWeight="Bold" Foreground="{StaticResource ZBrushWhite}"/>
                            <TextBlock Text="Uninstaller" FontSize="11" Foreground="{StaticResource ZBrushLighterGray}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Navigation -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding NavItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:ZNavButton Content="{Binding Title}"
                                                     Icon="{Binding Icon}"
                                                     IsActive="{Binding IsActive}"
                                                     Margin="0,4">
                                    <controls:ZNavButton.Command>
                                        <Binding Path="DataContext.NavigateCommand"
                                                 RelativeSource="{RelativeSource AncestorType=Window}"
                                                 FallbackValue="{x:Null}"/>
                                    </controls:ZNavButton.Command>
                                    <controls:ZNavButton.CommandParameter>
                                        <Binding Path="Key"/>
                                    </controls:ZNavButton.CommandParameter>
                                </controls:ZNavButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Sidebar footer -->
                    <StackPanel Grid.Row="2" Margin="12,16,12,0">
                        <Separator Height="1" Background="{StaticResource ZBrushDarkGray}" Margin="0,0,0,14"/>
                        <TextBlock Text="{Binding AppVersion, StringFormat=Version {0}}" FontSize="11"
                                   Foreground="{StaticResource ZBrushLighterGray}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <controls:ZIconButton Icon="{StaticResource IconRefresh}"
                                                  Command="{Binding ReloadAllCommand}"
                                                  Foreground="{StaticResource ZBrushLighterGray}"
                                                  ToolTip="{Binding [Sidebar_ReloadAll], Source={x:Static services:LanguageManager.Instance}}"/>
                            <controls:ZIconButton Icon="{StaticResource IconInfo}"
                                                  Foreground="{StaticResource ZBrushLighterGray}"
                                                  ToolTip="{Binding [Sidebar_About], Source={x:Static services:LanguageManager.Instance}}"
                                                  Margin="8,0,0,0"
                                                  Click="OnAboutClick"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ Main content area ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Page header -->
            <Border Grid.Row="0" Padding="28,22,28,0">
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource ZBrushBlack}"/>
                    <TextBlock Text="{Binding PageSubtitle}" FontSize="13" Margin="0,4,0,0"
                               Foreground="{StaticResource ZBrushGray}"/>
                </StackPanel>
            </Border>

            <!-- Page content (Dynamic Clear & Add via ContentControl) -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Focusable="False">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                        <views:DashboardView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:ApplicationsViewModel}">
                        <views:ApplicationsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:StoreAppsViewModel}">
                        <views:StoreAppsView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:StartupViewModel}">
                        <views:StartupView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:PackagesViewModel}">
                        <views:PackagesView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:WindowsFeaturesViewModel}">
                        <views:WindowsFeaturesView/>
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                        <views:SettingsView/>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>

        <!-- ============ Confirmation dialog ============ -->
        <controls:ZDialog Grid.Column="0" Grid.ColumnSpan="2" x:Name="ConfirmDialog"
                          Title="Xác nhận gỡ cài đặt"
                          Message="Bạn có chắc muốn gỡ cài đặt ứng dụng này?"
                          ConfirmText="Gỡ cài đặt" CancelText="Huỷ bỏ"
                          Panel.ZIndex="100"/>

        <!-- ============ Application Details Modal Overlay ============ -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2" Background="#7F000000"
              Visibility="{Binding Applications.IsDetailsModalOpen, Converter={StaticResource BoolToVis}}"
              PreviewMouseDown="OnModalBackdropMouseDown"
              Panel.ZIndex="105">
            <views:AppDetailsModal DataContext="{Binding Applications}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="24"/>
        </Grid>

        <!-- ============ Deep Clean Modal Overlay ============ -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2" Background="#7F000000"
              Visibility="{Binding DeepClean.IsOpen, Converter={StaticResource BoolToVis}}"
              PreviewMouseDown="OnModalBackdropMouseDown"
              Panel.ZIndex="95">
            <views:DeepCleanView DataContext="{Binding DeepClean}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Margin="24"/>
        </Grid>

        <!-- ============ Toast notifications ============ -->
        <controls:ZToastHost Grid.Column="1" x:Name="ToastHost"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,78,18,0" Panel.ZIndex="90"/>
    </Grid>
</controls:ZWindow>