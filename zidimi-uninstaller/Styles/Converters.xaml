<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:zidimi_uninstaller.Converters">

    <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
    <conv:InverseBoolConverter x:Key="InverseBool"/>
    <conv:NullOrEmptyToVisibilityConverter x:Key="NullToVis" ShowWhenEmpty="True"/>
    <conv:NullOrEmptyToVisibilityConverter x:Key="NotNullToVis" ShowWhenEmpty="False"/>
    <conv:BoolToOpacityConverter x:Key="BoolToOpacity"/>
    <conv:IntToVisibilityConverter x:Key="IntToVis" ShowWhenZero="False"/>
    <conv:IntToVisibilityConverter x:Key="ZeroToVis" ShowWhenZero="True"/>
    <conv:UninstallerTypeToBadgeConverter x:Key="KindToBadge"/>

</ResourceDictionary>