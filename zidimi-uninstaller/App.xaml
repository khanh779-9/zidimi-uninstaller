<Application x:Class="zidimi_uninstaller.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:zidimi_uninstaller"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Styles -->
                <ResourceDictionary Source="Styles/Colors.xaml"/>
                <ResourceDictionary Source="Styles/Icons.xaml"/>
                <ResourceDictionary Source="Styles/Converters.xaml"/>
                <!-- Base / common -->
                <ResourceDictionary Source="Controls/Common.xaml"/>
                <!-- Individual custom control styles -->
                <ResourceDictionary Source="Controls/ZButton.xaml"/>
                <ResourceDictionary Source="Controls/ZIconButton.xaml"/>
                <ResourceDictionary Source="Controls/ZNavButton.xaml"/>
                <ResourceDictionary Source="Controls/ZBadge.xaml"/>
                <ResourceDictionary Source="Controls/ZCard.xaml"/>
                <ResourceDictionary Source="Controls/ZCheckBox.xaml"/>
                <ResourceDictionary Source="Controls/ZSearchBox.xaml"/>
                <ResourceDictionary Source="Controls/ZToggleButton.xaml"/>
                <ResourceDictionary Source="Controls/ZToggleSwitch.xaml"/>
                <ResourceDictionary Source="Controls/ZProgressRing.xaml"/>
                <ResourceDictionary Source="Controls/ZProgressBar.xaml"/>
                <ResourceDictionary Source="Controls/ZSectionHeader.xaml"/>
                <ResourceDictionary Source="Controls/ZStatCard.xaml"/>
                <ResourceDictionary Source="Controls/ZEmptyState.xaml"/>
                <ResourceDictionary Source="Controls/ZToggleRow.xaml"/>
                <ResourceDictionary Source="Controls/ZAppCard.xaml"/>
                <ResourceDictionary Source="Controls/ZInfoRow.xaml"/>
                <ResourceDictionary Source="Controls/ZIconText.xaml"/>
                <ResourceDictionary Source="Controls/ZDialog.xaml"/>
                <ResourceDictionary Source="Controls/ZToastHost.xaml"/>
                <ResourceDictionary Source="Controls/ZWindowStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>